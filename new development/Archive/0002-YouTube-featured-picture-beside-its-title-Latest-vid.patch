     /// </summary>
     public static string? Thumbnail(string? stored, string? videoId, string size = "mqdefault") =>
         !string.IsNullOrWhiteSpace(videoId) && videoId.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_')
