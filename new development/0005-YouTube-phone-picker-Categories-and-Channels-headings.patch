     private string ChannelHref(VideoChannel c) => CurrentCategoryHref + (CurrentCategoryHref.Contains('?') ? "&" : "?") + "channel=" + Uri.EscapeDataString(c.ChannelId);
     private string PhoneCurrent => channels.FirstOrDefault(IsSelected) is { } c ? ChannelHref(c) : CurrentCategoryHref;
