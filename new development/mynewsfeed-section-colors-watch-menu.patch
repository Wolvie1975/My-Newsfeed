@@ -159,7 +159,7 @@
                             <a href="box-office" aria-current="@(onBoxOffice ? "page" : null)">Box Office</a>
                         </div>
                     </div>
-                    <div class="mobile-nav-group" role="group" aria-labelledby="mobile-tech-heading">
