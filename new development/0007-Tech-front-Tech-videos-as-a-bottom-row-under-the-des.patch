     color: var(--text-2);
     font-size: 12px;
 }
+/* Tech videos as the front's last row, under the desks: a double rule, thumbnails over their titles, three across
+   (six from 1920px). Phones keep their own video rail (.tc-video-rail in mobile.css). */
+.pub .tc-video-band {
+    margin-top: 32px;
+    padding-top: 16px;
+    border-top: 3px double var(--text);
+}
+.pub .tc-video-band .tc-videos__list {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    column-gap: 24px;
+}
+.pub .tc-video-band .yt-row {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    border-bottom: 0;
+}
+.pub .tc-video-band .yt-row:nth-child(n + 4) {
+    display: none;
+}
+.pub .tc-video-band .yt-row__thumb {
+    width: 100%;
+    aspect-ratio: 16 / 9;
+}
+@media (min-width: 1920px) {
+    .pub .tc-video-band .tc-videos__list {
+        grid-template-columns: repeat(6, minmax(0, 1fr));
+    }
+    .pub .tc-video-band .yt-row:nth-child(n + 4) {
+        display: flex;
+    }
+}
 
