# Copy to .env (which is git-ignored) and fill in. docker compose reads .env automatically.
SQL_CONNECTION=Server=sql2025,1433;Database=WebScraper;User Id=sa;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True;
ADMIN_PASSWORD=CHANGE_ME
# Host port the site is published on.
WEB_PORT=8085

# Time zone used to decide which calendar day each article date falls on in the public feed (an IANA name, e.g. America/Chicago).
DISPLAY_TIMEZONE=UTC
