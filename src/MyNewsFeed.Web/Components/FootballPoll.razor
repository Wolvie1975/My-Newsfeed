@using MyNewsFeed.Web.Data.Models

<section class="football-poll" aria-label="@Poll.PollName">
    <h3>@Poll.PollName</h3>
    <table>
        <caption class="sr-only">@Poll.PollName · @Poll.SeasonLabel</caption>
        <thead><tr><th scope="col">RK</th><th scope="col">TEAM</th><th scope="col">REC</th><th scope="col">PTS</th><th scope="col">TREND</th></tr></thead>
        <tbody>
            @foreach (var team in Teams)
            {
                var movement = RankingsQuery.Movement(team);
                var change = team.PreviousRank is { } previous && team.Rank is { } rank ? previous - rank : 0;
                <tr class="@(team.IsBig12 == true ? "ranking-big12" : null)">
                    <td>@team.Rank</td>
                    <th scope="row"><span class="standing-team-name">
                        @if (EventsText.LogoUrl(team.LogoUrl) is { } logo)
                        { <img src="@logo" alt="" width="22" height="22" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" /> }
                        <span>
                            @if (FeedQuery.SafeHref(team.TeamUrl) is { } url)
                            { <a href="@url" target="_blank" rel="noopener noreferrer">@team.TeamName</a> }
                            else { @team.TeamName }
                            @if (team.FirstPlaceVotes is > 0) { <span class="poll-votes"> (@team.FirstPlaceVotes)</span> }
                            @if (team.IsBig12 == true) { <span class="sr-only"> · Big 12</span> }
                        </span>
                    </span></th>
                    <td>@(team.Record ?? "—")</td>
                    <td>@(team.Points?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td>
                    <td><span class="poll-trend @(change > 0 ? "up" : change < 0 ? "down" : null)" aria-label="@movement" title="@movement">@(team.PreviouslyUnranked && team.PreviousRank is null ? "NR" : change > 0 ? $"↑{change}" : change < 0 ? $"↓{-change}" : "—")</span></td>
                </tr>
            }
        </tbody>
    </table>
    @if (FeedQuery.SafeHref(Poll.SourceUrl) is { } source)
    { <p class="poll-source"><a href="@source" target="_blank" rel="noopener noreferrer">Complete rankings ↗</a></p> }
</section>

@code {
    [Parameter, EditorRequired] public SportsRankingPoll Poll { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<SportsRankingTeam> Teams { get; set; } = [];
}
