@* Shared scraper status table. Sources without an editor display their name as plain text. *@
@if (Rows.Count == 0)
{
    <p>@Empty</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Status</th><th>Name</th><th>@ItemLabel</th>
                    @if (ShowUpcoming)
                    {
                        <th>Upcoming</th>
                    }
                    <th>Last refreshed</th><th>Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr class="@(row.Enabled ? null : "text-muted")">
                        <td><StatusBadge Level="row.Level" /></td>
                        <td>
                            @if (EditBase is not null)
                            {
                                <a href="@EditBase/@row.Id/edit">@row.Name</a>
                            }
                            else
                            {
                                @row.Name
                            }
                        </td>
                        <td>@row.ItemCount</td>
                        @if (ShowUpcoming)
                        {
                            <td>@row.Upcoming</td>
                        }
                        <td class="text-nowrap">@Dates.Stamp(row.LastSeen)</td>
                        <td>
                            @row.Note
                            @if (!string.IsNullOrWhiteSpace(row.Error))
                            {
                                <div class="small text-danger text-break" title="@row.Error">@(row.Error.Length <= 160 ? row.Error : row.Error[..160] + "…")</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HealthRow> Rows { get; set; } = [];
    [Parameter, EditorRequired] public string ItemLabel { get; set; } = "";
    [Parameter] public string? EditBase { get; set; }
    [Parameter] public bool ShowUpcoming { get; set; }
    [Parameter] public string Empty { get; set; } = "";
}
