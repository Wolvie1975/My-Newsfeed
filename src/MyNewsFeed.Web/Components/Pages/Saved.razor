@page "/saved"
@layout PublicLayout

<PageTitle>Saved · MyNewsFeed</PageTitle>

@* Saved articles live only in this browser (localStorage), so the server sends an empty shell and public.js draws the
   cards from each article's saved copy. They stay after the scraper drops the article from the database. *@

<PageHeading Title="Saved articles" Eyebrow="YOUR READING LIST" Description="Saved in this browser only. They are not shared with your other devices." />

<div class="favorites-toolbar" hidden data-reading-toolbar>
    <label>Reading list <select data-reading-filter><option value="all">All saved</option><option value="unread">Unread</option><option value="read">Read</option></select></label>
</div>
<p class="count" data-reading-count></p>
<p class="count" data-saved-status aria-live="polite"></p>

<section class="feed" aria-label="Saved articles" data-saved-list></section>

<p class="empty" data-saved-empty hidden>
    No articles in this view. Save articles from <a href="news">News</a>, or choose All saved.
</p>

<noscript><p class="empty">Saved articles need JavaScript turned on.</p></noscript>
