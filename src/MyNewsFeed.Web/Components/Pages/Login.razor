@page "/login"
@using MyNewsFeed.Web.Auth

<PageTitle>Sign in</PageTitle>

<h1>Admin sign in</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger" role="alert">Incorrect password.</div>
}

@* Static (non-interactive) page: posts to /account/login, which validates the antiforgery token. *@
<form method="post" action="/account/login" class="mt-3" style="max-width: 24rem;">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control"
               autocomplete="current-password" autofocus required />
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private string SafeReturnUrl => AdminAuth.SafeReturnUrl(ReturnUrl);
}
