@inherits LayoutComponentBase
@inject NavigationManager Nav

@{
    var path = Nav.ToBaseRelativePath(Nav.Uri);
    var onEvents = path.StartsWith("events", StringComparison.OrdinalIgnoreCase);
    var onVideos = path.StartsWith("videos", StringComparison.OrdinalIgnoreCase);
    var onNews = path.StartsWith("news", StringComparison.OrdinalIgnoreCase);
    var onHome = path.Length == 0 || path[0] is '?' or '#';
}

<div class="pub">
    <header class="site-header">
        <a class="brand" href="">MyNewsFeed</a>

        @* Wide screens: the navigation sits in the header. Phones get the same links in a bar under it (below), so the
           sticky header stays one row tall. *@
        <nav class="site-nav site-nav--inline" aria-label="Main">
            <a href="" aria-current="@(onHome ? "page" : null)">Home</a>
            <a href="news" aria-current="@(onNews ? "page" : null)">News</a>
            <a href="events" aria-current="@(onEvents ? "page" : null)">Sports Events</a>
            <a href="videos" aria-current="@(onVideos ? "page" : null)">Videos</a>
        </nav>

        <div class="header-actions">
            @* Label and pressed state are kept in sync by public.js. *@
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-theme-toggle>
                <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
                <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            </button>
            <AuthorizeView>
                <Authorized>
                    <a class="admin-link" href="admin/sources">Admin</a>
                </Authorized>
                <NotAuthorized>
                    <a class="admin-link" href="login">Admin sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <nav class="site-nav site-nav--bar" aria-label="Main">
        <a href="" aria-current="@(onHome ? "page" : null)">Home</a>
        <a href="news" aria-current="@(onNews ? "page" : null)">News</a>
        <a href="events" aria-current="@(onEvents ? "page" : null)">Sports Events</a>
        <a href="videos" aria-current="@(onVideos ? "page" : null)">Videos</a>
    </nav>

    <main class="page">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
