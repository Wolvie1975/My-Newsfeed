@using myNewspaper.Web.Data
@inject FeedDates Dates

@* One game as a table row. On phones and tablets CSS lays the cells out as a stacked card; from 1180px it is a real
   table row. Roles are explicit because the card layout changes the display values that carry table semantics. *@

@{
    var school = string.IsNullOrWhiteSpace(Item.SchoolName) ? "Our team" : Item.SchoolName.Trim();
    var opponent = string.IsNullOrWhiteSpace(Item.Opponent) ? "Opponent to be announced" : Item.Opponent.Trim();

    // The calendar is the school's own: IsAway = 1 puts the school in the Away column, 0 in the Home column. A null
    // (unknown) puts the school in the Home column and shows no Away/Home labels rather than guessing.
    var known = Item.IsNeutral != true && Item.IsAway is not null;
    var schoolAway = Item.IsNeutral != true && Item.IsAway == true;
    var (awayName, awayLogo) = schoolAway ? (school, Item.TeamLogoUrl) : (opponent, Item.OpponentLogoUrl);
    var (homeName, homeLogo) = schoolAway ? (opponent, Item.OpponentLogoUrl) : (school, Item.TeamLogoUrl);

    var schoolRecord = Records.Find(Item.ProviderKey, Item.Sport, school, Item.SchoolId?.ToString());
    var opponentRecord = Records.Find(Item.ProviderKey, Item.Sport, opponent, Item.OpponentSchoolId?.ToString());
    var time = EventsText.TimeLabel(Item, Dates);
    var (city, venue) = EventsText.SplitLocation(Item.Location);
    var stats = FeedQuery.SafeHref(Item.LiveStatsUrl);
    var video = FeedQuery.SafeHref(Item.StreamUrl);
    var audio = FeedQuery.SafeHref(Item.AudioUrl);
    var radio = EventsText.RadioLabel(Item.Radio);
    var details = FeedQuery.SafeHref(Item.Url);
    var hasLinks = !string.IsNullOrWhiteSpace(Item.Tv) || stats is not null || video is not null || details is not null || audio is not null || radio is not null;
}

<tr class="game" role="row" data-sports-teams="@SportsTeamPreferences.Keys(Item.SchoolName, Item.Opponent)">
    <td class="td-sport @(string.IsNullOrWhiteSpace(Item.Sport) ? "td-sport--none" : "")" role="cell">@Item.Sport @if (Item.IsNeutral == true) { <span class="neutral-label">Neutral site</span> }</td>
    <td class="td-away" role="cell"><TeamCell Record="@(schoolAway ? schoolRecord : opponentRecord)" Name="@awayName" LogoUrl="@awayLogo" Label="@(Item.IsNeutral == true ? "Team" : known ? "Away" : null)" /></td>
    <td class="td-home" role="cell"><TeamCell Record="@(schoolAway ? opponentRecord : schoolRecord)" Name="@homeName" LogoUrl="@homeLogo" Label="@(Item.IsNeutral == true ? "Team" : known ? "Home" : null)" /></td>
    <td class="td-time @(time.Contains("Time TBD") ? "is-tbd" : "")" role="cell">@time</td>
    <td class="td-loc" role="cell">
        @if (city is not null)
        {
            <div class="loc">
                <span>@city</span>
                @if (venue is not null)
                {
                    <span class="loc__venue">@venue</span>
                }
            </div>
        }
    </td>
    <td class="td-links @(hasLinks ? "" : "td-links--none")" role="cell">
        @if (hasLinks)
        {
            <div class="links event-links">
                @if (!string.IsNullOrWhiteSpace(Item.Tv))
                {
                    <div class="event-broadcast"><span class="event-broadcast__label">TV / Streaming</span><span class="tv__net">@Item.Tv.Trim()</span></div>
                }
                @if (radio is not null)
                { <div class="event-broadcast"><span class="event-broadcast__label">Radio</span><span>@radio</span></div> }
                @if (stats is not null || video is not null || audio is not null || details is not null)
                {
                    <div class="event-link-actions">
                        @if (stats is not null) { <a href="@stats" target="_blank" rel="noopener noreferrer">Stats</a> }
                        @if (video is not null) { <a href="@video" target="_blank" rel="noopener noreferrer">Video</a> }
                        @if (audio is not null) { <a href="@audio" target="_blank" rel="noopener noreferrer">Audio</a> }
                        @if (details is not null) { <a href="@details" target="_blank" rel="noopener noreferrer">Details</a> }
                    </div>
                }
            </div>
        }
    </td>
</tr>

@code {
    [Parameter] public TeamRecords Records { get; set; } = TeamRecords.Empty;
    [Parameter, EditorRequired] public EventItem Item { get; set; } = default!;
}
