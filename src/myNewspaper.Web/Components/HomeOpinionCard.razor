@using myNewspaper.Web.Components.Feed
@inject FeedDates Dates
<section class="d-card d-opinion" data-home-section="opinion" data-home-opinion
         data-opinion-hour="@Snapshot.Hour" data-opinion-refresh-after="@Snapshot.RefreshAfterMs" aria-labelledby="h-opinion">
    <div class="d-card__head">
        <h2 class="d-card__title" id="h-opinion">Opinion <span class="d-card__count">Publisher spotlight · rotates hourly</span></h2>
        @if (Snapshot.CategoryId is {} categoryId) { <a class="d-more" href="news?category=@categoryId">View all →</a> }
    </div>
    @if (Snapshot.Failed) { <p class="d-empty" role="status">Opinion is temporarily unavailable. Please try again.</p> }
    else if (Snapshot.Article is {} item) {
        var href = FeedQuery.SafeHref(item.Url);
        var title = FeedText.StripEmoji(item.Title);
        var summary = FeedText.StripEmoji(FeedQuery.Excerpt(item.Description));
        var image = FeedQuery.SafeHref(item.ImageUrl);
        var source = FeedText.SourceName(item.SourceLabel, item.SourceUrl);
        <ul class="d-list"><li class="d-story" data-news-url="@href" data-news-source="@source" data-opinion-article="@item.Id">
            <a class="d-thumb" href="@href" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                <span class="d-thumb__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m21 16-5-5-8 9" /></svg></span>
                @if (image != null) { <img src="@image" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" /> }
            </a>
            <div class="d-story__body">
                <div class="d-story__top"><span class="d-src">@source</span><span class="d-story__tools">
                    <ShareButton Url="@item.Url" Title="@title" />
                    <SaveButton Item="item" Title="@title" Source="@source" Summary="@summary" />
                </span></div>
                <h3 class="d-story__title">@if(href != null) { <a href="@href" target="_blank" rel="noopener noreferrer">@title</a> } else { @title }</h3>
                @if(!item.Undated) { <p class="d-story__date"><time datetime="@item.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")" title="@Dates.PublishedFull(item.Date)">Published @Dates.Published(item.Date) · @Dates.Time(item.Date)</time></p> }
                @if(!string.IsNullOrEmpty(summary)) { <p class="d-story__sum">@summary</p> }
            </div>
        </li></ul>
        <p class="d-empty" data-opinion-filtered hidden>This publisher is hidden by your reading preferences. <a href="news?category=@Snapshot.CategoryId">Browse Opinion</a>.</p>
    } else { <p class="d-empty">No Opinion articles available yet. Check back soon.</p> }
</section>
@code {
    [Parameter, EditorRequired] public HomeOpinion Snapshot { get; set; } = new(null,null,0,60000);
}
