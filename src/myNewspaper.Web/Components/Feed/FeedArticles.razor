@using myNewspaper.Web.Data
@inject FeedDates Dates

@* The article cards (and, on mobile, the day headings between them). Rendered by the home page for the first
   batch and by the /feed/more endpoint for "Load more", so both produce identical markup. *@

@{
    var previousDay = PreviousDay;
    var previousGroup = PreviousGroup;
    var nowUtc = DateTime.UtcNow;
}

@for (var i = 0; i < Items.Count; i++)
{
    var item = Items[i];
    var dayKey = Dates.DayKey(item);
    var isLead = LeadFirst && i == 0;
    var href = FeedQuery.SafeHref(item.Url);
    var image = FeedQuery.SafeHref(item.ImageUrl);
    var sourceName = FeedText.SourceName(item.SourceLabel, item.SourceUrl);
    var title = FeedText.StripEmoji(item.Title);
    var summary = FeedText.StripEmoji(FeedQuery.Excerpt(item.Description));

    if (dayKey != previousDay)
    {
        previousDay = dayKey;
        <p class="daylabel">
            <span>@Dates.GroupLabel(dayKey)</span>
            @if (i == 0 && Total is int total)
            {
                <span>@total @(total == 1 ? "article" : "articles")</span>
            }
        </p>
    }
    if (Cards && Dates.CardGroupKey(item, GroupBy, nowUtc) is var groupKey && groupKey != previousGroup && !NoGroupHeadings)
    {
        previousGroup = groupKey;
        @* Desktop cards only; phones keep the day label above. *@
        <h3 class="hc-group" id="@($"hc-{groupKey}")" data-hc-group="@groupKey">@Dates.CardGroupLabel(item, GroupBy, nowUtc)</h3>
    }

    <article data-article-story="@(isLead || (PhoneFeatureFirst && i == 0) ? "feature" : "row")" data-image-layout="compact" @key="item.Id" data-article-id="@item.Id" data-news-url="@href" data-news-source="@sourceName" class="article @(Rows ? (i == 0 ? "hc-row hc-row--first" : "hc-row") : null) @(isLead ? "article--lead" : "") @(PhoneFeatureFirst && i == 0 ? "mx-list-feature" : null) @(Cards ? "hc-card " + PhoneColors.ForCategory(item.CategoryName) : null)">
        @* Default image: the placeholder background shows through when there is no image or it fails to load. *@
        <div class="thumb" data-article-media aria-hidden="true">
            @if (image is not null)
            {
                <img src="@image" alt="" loading="@(isLead ? "eager" : "lazy")" decoding="async"
                     referrerpolicy="no-referrer" onerror="this.remove()" />
            }
        </div>
        <div class="body">
            @if (item.CategoryName is not null)
            {
                <a class="cat" href="news/all?category=@item.CategoryId">@item.CategoryName</a>
            }
            <h2 class="title">
                @if (href is not null)
                {
                    <a href="@href" target="_blank" rel="noopener noreferrer">@(title.Length > 0 ? title : item.Title)</a>
                }
                else
                {
                    @(title.Length > 0 ? title : item.Title)
                }
            </h2>
            @if (!string.IsNullOrEmpty(summary))
            {
                <p class="summary">@summary</p>
            }
            <div class="src">
                <span class="article-publisher"><span class="src__mark" aria-hidden="true">@FeedText.SourceMark(sourceName)</span>
                <span class="src__name">@sourceName</span></span>
                @if (!item.Undated)
                {
                <span class="src__sep" aria-hidden="true">·</span>
                <time datetime="@item.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")" title="@Dates.PublishedFull(item.Date)">@* Date and time in one element; on mobile the day heading already gives the date, so only the time shows. *@<span class="pubdate__day">@Dates.Published(item.Date)<span class="pubdate__sep" aria-hidden="true"> · </span></span><span class="pubdate__time">@Dates.Time(item.Date)</span></time>
                }
                else
                {
                    <span class="publication-unavailable">Publication date unavailable</span>
                }
                <span class="article-actions"><ShareButton Url="@item.Url" Title="@(title.Length > 0 ? title : item.Title)" />
                <SaveButton Item="item" Title="@(title.Length > 0 ? title : item.Title)" Source="@sourceName" Summary="@summary" /></span>
            </div>
            @if (isLead && href is not null)
            {
                <a class="more" href="@href" target="_blank" rel="noopener noreferrer">
                    Read on @sourceName
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                </a>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FeedItem> Items { get; set; } = [];

    /// <summary>The first article is the large lead card (only on the first batch).</summary>
    [Parameter] public bool LeadFirst { get; set; }

    /// <summary>Phones: the first article gets the dark feature styling (only on the first batch).</summary>
    [Parameter] public bool PhoneFeatureFirst { get; set; }

    /// <summary>Day (yyyy-MM-dd) of the last article already on the page, so a batch doesn't repeat its heading.</summary>
    [Parameter] public string? PreviousDay { get; set; }

    /// <summary>When set, the first day heading also shows the total article count (mobile).</summary>
    [Parameter] public int? Total { get; set; }

    /// <summary>Desktop card layout for the All headlines pages (docs/headline-cards-handoff.md); phones still render these as rows.</summary>
    [Parameter] public bool Cards { get; set; }
    [Parameter] public bool Rows { get; set; }

    /// <summary>Cards only: how headings are grouped ("hour" or "day").</summary>
    [Parameter] public string GroupBy { get; set; } = "day";

    /// <summary>Cards only: the group of the last article already on the page, so a batch doesn't repeat its heading.</summary>
    [Parameter] public string? PreviousGroup { get; set; }

    /// <summary>Cards only: the lead and the three beside it sit above the grid's headings.</summary>
    [Parameter] public bool NoGroupHeadings { get; set; }
}
