@inject FeedDates Dates

@if (FeedQuery.SafeHref(Item.Url) is { } href)
{
    <button class="save" type="button" hidden data-save data-kind="video"
            data-url="@href" data-title="@Item.Title" data-source="@Item.ChannelName"
            data-image="@VideosText.Thumbnail(Item.ThumbnailUrl, Item.VideoId)"
            data-date="@Item.PublishedAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")"
            data-date-label="@Dates.Published(Item.PublishedAt)"
            aria-pressed="false" aria-label="Watch later" title="Watch later">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z"></path></svg>
        <span data-save-label>Watch later</span>
    </button>
}

@code {
    [Parameter, EditorRequired] public VideoItem Item { get; set; } = null!;
}
