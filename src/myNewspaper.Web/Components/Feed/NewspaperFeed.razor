@using myNewspaper.Web.Data
@if (Cards)
{
    @* Headline cards (docs/headline-cards-handoff.md): the lead and three beside it, then a grid with hour or day
       headings. Phones flatten these wrappers into the usual one-column list. *@
    @if (Featured && Items.Count > 0)
    {
        <div class="hc-top">
            <section class="hc-lead" aria-label="Lead story"><FeedArticles Items="@Items.Take(1).ToArray()" LeadFirst="true" PhoneFeatureFirst="PhoneFeatureFirst" Cards="true" NoGroupHeadings="true" /></section>
            @if (Items.Count > 1) {
                <section class="hc-side" aria-label="Latest headlines"><FeedArticles Items="@Items.Skip(1).Take(3).ToArray()" Cards="true" NoGroupHeadings="true" /></section>
            }
        </div>
    }
    @if (CardRemaining.Count > 0) {
        <div class="hc-grid" data-hc-grid><FeedArticles Items="CardRemaining" PhoneFeatureFirst="@(PhoneFeatureFirst && !Featured)" PreviousDay="@PreviousDay" Total="Total" Cards="true" GroupBy="@GroupBy" /></div>
    }
}
else
{
@if (Featured && Items.Count > 0)
{
    <div class="paper-top">
        <section class="paper-lead" aria-label="Lead story"><FeedArticles Items="@Items.Take(1).ToArray()" LeadFirst="true" PhoneFeatureFirst="PhoneFeatureFirst" /></section>
        @if (Items.Count > 1) {
            <section class="paper-latest" aria-label="Latest headlines"><h2 class="paper-label">Latest headlines</h2><FeedArticles Items="@Items.Skip(1).Take(4).ToArray()" /></section>
        }
        @if (Items.Count > 5) {
            <section class="paper-support" aria-label="More featured stories"><FeedArticles Items="@Items.Skip(5).Take(3).ToArray()" /></section>
        }
    </div>
}
@if (Remaining.Count > 0) {
    <h2 class="paper-label">More stories</h2>
    <div class="paper-rows"><FeedArticles Items="Remaining" PhoneFeatureFirst="@(PhoneFeatureFirst && !Featured)" PreviousDay="@PreviousDay" Total="Total" /></div>
}
}
@code {
    [Parameter] public IReadOnlyList<FeedItem> Items { get; set; } = [];
    [Parameter] public bool PhoneFeatureFirst { get; set; }
    [Parameter] public bool Featured { get; set; }
    [Parameter] public string? PreviousDay { get; set; }
    [Parameter] public int? Total { get; set; }
    /// <summary>Headline cards on desktop (the All headlines pages).</summary>
    [Parameter] public bool Cards { get; set; }
    /// <summary>Cards only: "hour" (a busy today) or "day".</summary>
    [Parameter] public string GroupBy { get; set; } = "day";
    private IReadOnlyList<FeedItem> Remaining => Featured ? Items.Skip(8).ToArray() : Items;
    private IReadOnlyList<FeedItem> CardRemaining => Featured ? Items.Skip(4).ToArray() : Items;
}
