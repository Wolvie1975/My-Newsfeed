@using myNewspaper.Web.Data

@if (FeedQuery.SafeHref(Url) is { } href)
{
    <button class="share-button" type="button" hidden data-share-open
            data-url="@href" data-title="@Title" data-kind="@Kind" aria-label="@Label" title="@Label">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg>
        @if (Labelled) { <span aria-hidden="true">Share</span> }
    </button>
}

@code {
    [Parameter] public string Kind { get; set; } = "article";
    private string Label => Kind == "video" ? "Share video" : "Share article";
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Title { get; set; } = "";
    /// <summary>Show "Share" beside the icon (the phone dark block).</summary>
    [Parameter] public bool Labelled { get; set; }
}
