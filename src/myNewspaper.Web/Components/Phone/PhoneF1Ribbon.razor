<PhoneRibbon Title="F1" Section="sports" Kicker="@($"Formula 1{(Season is { } season ? $" · {season} season" : "")}")">
    <SectionSelect Id="f1-view-m" Label="View" Current="@(View == "schedule" ? "f1" : "f1/" + View)" AlwaysSelect="true"
        Choices="@(new NavigationChoice[] { new("f1", "Schedule"), new("f1/results", "Results"), new("f1/standings", "Standings") })" />
</PhoneRibbon>
@code {
    [Parameter] public int? Season { get; set; }
    [Parameter] public string View { get; set; } = "schedule";
}
