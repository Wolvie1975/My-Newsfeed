<ol class="mx-standing-list" aria-label="@Group.Name">
    @foreach (var team in Teams)
    {
        var primary = PhoneSports.Primary(Group, team, Soccer);
        <li data-sports-teams="@SportsTeamPreferences.Keys(team.Row.TeamName)">
            <b>@(team.Row.Rank?.ToString() ?? team.Row.Position.ToString())</b>
            <span>
                <span class="mx-standing-name">
                    <PhoneStandingLogo Url="@team.Row.LogoUrl" />
                    @if (FeedQuery.SafeHref(team.Row.TeamUrl) is { } url) { <a href="@url" target="_blank" rel="noopener noreferrer">@team.Row.TeamName</a> }
                    else { <b>@team.Row.TeamName</b> }
                </span>
                <small>@PhoneSports.Secondary(Group, team, Soccer)</small>
            </span>
            <strong>@primary</strong>
        </li>
    }
</ol>
@code {
    [Parameter, EditorRequired] public StandingGroup Group { get; set; } = new("", "", [], []);
    [Parameter] public bool Soccer { get; set; }
    [Parameter] public IEnumerable<StandingTeam> Teams { get; set; } = [];
}
