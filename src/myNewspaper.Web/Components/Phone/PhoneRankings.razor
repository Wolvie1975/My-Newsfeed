@inject FeedDates Dates
<div class="mx-phone" data-phone-sports="rankings">
    <PhoneRibbon Title="Top 25" Section="sports" Kicker="@(Data.Poll is { } poll ? $"Poll dated {Dates.Published(poll.PublishedAtUtc)} · Big 12 highlighted" : "National polls")">
        @if (Data.Sources.Count > 0)
        {
            <form class="mx-ribbon__field" method="get" action="rankings">
                <label for="ranking-source-m">Poll</label><select id="ranking-source-m" name="sourceId" onchange="this.form.requestSubmit()">
                    @foreach (var source in Data.Sources) { <option value="@source.Id" selected="@(Data.Selected?.Id == source.Id)">@source.DisplayName</option> }
                </select><noscript><button class="nf-btn nf-btn--secondary" type="submit">Go</button></noscript>
            </form>
        }
    </PhoneRibbon>
    @if (Data.AvailabilityError is { } error) { <p class="mx-note" role="status">@error <a href="@RetryHref">Try again</a></p> }
    else if (Data.Selected is null) { <p class="mx-note">No ranking sources are enabled for this selection.</p> }
    else if (Data.Poll is null || Data.Teams.Count == 0) { <p class="mx-note">Rankings not available yet.</p> }
    else
    {
        @if (RankingsQuery.Freshness(Data.Selected, DateTime.UtcNow) is { } warning) { <p class="mx-note" role="status">@warning</p> }
        @if (RankingsQuery.OldPoll(Data.Poll, DateTime.UtcNow)) { <p class="mx-note">Latest available poll; published more than two weeks ago.</p> }
        @if (Data.Teams.FirstOrDefault(t => t.Rank == 1) is { } leader)
        {
            <section class="mx-block" aria-label="Number one">
                <span class="mx-block__kicker">@Data.Poll.PollName · @Data.Poll.SeasonLabel</span>
                <div class="mx-number">1</div><h2 class="mx-block__title">@leader.TeamName</h2>
                <p class="mx-block__note">@(leader.Record ?? "Record unavailable") · @RankingsQuery.Movement(leader)</p>
                @if (Movers.Count > 0)
                {
                    <h3 class="mx-block__kicker">Biggest moves</h3><div class="mx-tiles">
                        @foreach (var team in Movers) { <div class="mx-tile"><span class="mx-tile__label">@team.TeamName</span><b class="mx-tile__value">@PhoneSports.MoveLabel(team)</b><span class="mx-tile__sub">No. @team.Rank</span></div> }
                    </div>
                }
            </section>
        }
        @if (Data.Teams.Where(t => t.Rank is null or > 1).ToList() is { Count: > 0 } rest)
        {
            <section class="mx-sport-list"><div class="mx-head"><h2>The rest of the poll</h2></div><PhoneRankRows Teams="rest" /></section>
        }
        @if (FeedQuery.SafeHref(Data.Poll.SourceUrl) is { } url) { <a class="mx-more" href="@url" target="_blank" rel="noopener noreferrer">View poll source ↗</a> }
        <p class="mx-note">Data via ESPN · @Data.Poll.PollName</p>
    }
</div>
@code {
    [Parameter] public RankingsPage Data { get; set; } = new([], null, null, []);
    [Parameter] public string RetryHref { get; set; } = "rankings";
    private IReadOnlyList<myNewspaper.Web.Data.Models.SportsRankingTeam> Movers => Data.Teams.Where(t => PhoneSports.Movement(t) > 0).OrderByDescending(t => PhoneSports.Movement(t)).Take(2)
        .Concat(Data.Teams.Where(t => PhoneSports.Movement(t) < 0).OrderBy(t => PhoneSports.Movement(t)).Take(1)).ToList();
}
