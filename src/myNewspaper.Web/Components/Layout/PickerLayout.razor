@inherits LayoutComponentBase

@* The edition picker and the first-PIN page: the public paper without its section header, because nothing behind the
   gate can be reached until a profile is open. *@
<div class="pub picker-page">
    <main class="picker">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
