@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject myNewspaper.Web.Profiles.ProfileContext Reader

@{
    var path = Nav.ToBaseRelativePath(Nav.Uri);
    var onSportsHub = path.Split('?')[0].TrimEnd('/').Equals("sports", StringComparison.OrdinalIgnoreCase);
    var onEntertainmentHub = path.Split('?')[0].TrimEnd('/').Equals("entertainment", StringComparison.OrdinalIgnoreCase);
    var bare = path.Split('?', '#')[0].TrimEnd('/');
    var onNewsHome = bare.Equals("news", StringComparison.OrdinalIgnoreCase);
    var onNewsSection = onNewsHome || bare.StartsWith("news/", StringComparison.OrdinalIgnoreCase);
    var onNewsAll = bare.Equals("news/all", StringComparison.OrdinalIgnoreCase);
    var onKansasCity = bare.Equals("news/kansas-city", StringComparison.OrdinalIgnoreCase);
    var onCollege = path.Equals("college", StringComparison.OrdinalIgnoreCase) || path.StartsWith("college/", StringComparison.OrdinalIgnoreCase) || path.StartsWith("college?", StringComparison.OrdinalIgnoreCase);
    var onF1 = path.Equals("f1", StringComparison.OrdinalIgnoreCase) || path.StartsWith("f1/", StringComparison.OrdinalIgnoreCase) || path.StartsWith("f1?", StringComparison.OrdinalIgnoreCase);
    var onTeams = path.StartsWith("settings", StringComparison.OrdinalIgnoreCase) || path.StartsWith("sports/teams", StringComparison.OrdinalIgnoreCase);
    var onEvents = path.StartsWith("events", StringComparison.OrdinalIgnoreCase);
    var onDigital = path.StartsWith("movies/digital", StringComparison.OrdinalIgnoreCase);
    var onWatch = path.StartsWith("watch",StringComparison.OrdinalIgnoreCase);
    var onMovies = path.StartsWith("movies", StringComparison.OrdinalIgnoreCase);
    var onTv = path.StartsWith("tv", StringComparison.OrdinalIgnoreCase);
    var onVideos = path.StartsWith("videos", StringComparison.OrdinalIgnoreCase);
    var onRankings = path.StartsWith("rankings", StringComparison.OrdinalIgnoreCase);
    var onStandings = path.StartsWith("standings", StringComparison.OrdinalIgnoreCase);
    var onScoreboard = path.StartsWith("scoreboard", StringComparison.OrdinalIgnoreCase);
    var onResults = path.StartsWith("box-score/", StringComparison.OrdinalIgnoreCase) || path.StartsWith("results", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("championship/results", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("mls/results", StringComparison.OrdinalIgnoreCase);
    var onBoxOffice = path.StartsWith("box-office", StringComparison.OrdinalIgnoreCase);
    var onEntertainmentNews = path.Split('?')[0].StartsWith("entertainment/news", StringComparison.OrdinalIgnoreCase);
    var onTvFilmNews = path.Split('?')[0].Equals("entertainment/tv-film", StringComparison.OrdinalIgnoreCase);
    var onSportsNews = path.Split('?')[0].StartsWith("sports/news", StringComparison.OrdinalIgnoreCase);
    var onBasketballNews = path.Split('?')[0].Equals("sports/mens-college-basketball/news", StringComparison.OrdinalIgnoreCase);
    var onBig12News = path.Split('?')[0].Equals("college/news", StringComparison.OrdinalIgnoreCase);
    var onSaved = path.StartsWith("saved", StringComparison.OrdinalIgnoreCase);
    var onHome = path.Length == 0 || path[0] is '?' or '#';
    var onSportsSection = onSportsHub || onSportsNews || onBasketballNews || onScoreboard || onEvents || onResults || onStandings || onRankings || onF1 || onCollege || onBig12News;
    var onEntertainmentSection = onEntertainmentHub || (onMovies && !onWatch) || onTv || onEntertainmentNews || onTvFilmNews || onBoxOffice;
}

<div class="pub" data-page="@(onHome ? "home" : null)">
    @* Header as in the approved concepts: on phones a coloured bar with the mark, the date and time, Saved and a Menu
       button that opens every section (also on iPad portrait, where the page below is the desktop layout); from 1024px
       a plain masthead row with the tile mark, the sections as text links and Saved and Settings on the right. *@
    <header class="site-header">
        <a class="brand" href="" aria-label="myNewspaper home">
            @* The marks are inline so their ink and folded corner follow the colour scheme: the page alone on the
               coloured phone bar, the page on its tile on the desktop paper. *@
            <svg class="brand-mark" viewBox="11 7 43 50" width="34" height="40" aria-hidden="true">
                <path class="brand-mark__page" d="M12 8h29l11 11v37H12z" />
                <path class="brand-mark__fold" d="M41 8v11h11z" />
                <g class="brand-mark__n"><rect x="16" y="12" width="21" height="5.5" rx="1" /><rect x="16" y="21" width="32" height="1.4" /><rect x="16" y="25.5" width="32" height="4.5" rx="1" /><rect x="16" y="33.5" width="15" height="12" rx="1" fill-opacity=".35" /><rect x="34" y="33.5" width="14" height="2.2" rx="1" /><rect x="34" y="38.3" width="14" height="2.2" rx="1" /><rect x="34" y="43.1" width="10" height="2.2" rx="1" /><rect x="16" y="48.5" width="32" height="2.2" rx="1" /></g>
            </svg>
            <svg class="brand-tile" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
                <rect class="bs-mark-tile" width="64" height="64" rx="14" />
                <path class="bs-mark-page" d="M12 8h29l11 11v37H12z" />
                <path class="bs-mark-fold" d="M41 8v11h11z" />
                <g class="bs-mark-n"><rect x="16" y="12" width="21" height="5.5" rx="1" /><rect x="16" y="21" width="32" height="1.4" /><rect x="16" y="25.5" width="32" height="4.5" rx="1" /><rect x="16" y="33.5" width="15" height="12" rx="1" fill-opacity=".35" /><rect x="34" y="33.5" width="14" height="2.2" rx="1" /><rect x="34" y="38.3" width="14" height="2.2" rx="1" /><rect x="34" y="43.1" width="10" height="2.2" rx="1" /><rect x="16" y="48.5" width="32" height="2.2" rx="1" /></g>
            </svg>
            <span class="brand-wordmark">myNewspaper</span>
        </a>

        <nav class="site-nav site-nav--inline" aria-label="Main">
            <a href="" aria-current="@(onHome ? "page" : null)">Home</a>
            <a href="news" aria-current="@(onNewsHome ? "page" : onNewsSection ? "true" : null)">News</a>
            <a href="sports" aria-current="@(onSportsHub ? "page" : onSportsSection ? "true" : null)">Sports</a>
            <a href="entertainment" aria-current="@(onEntertainmentHub ? "page" : onEntertainmentSection ? "true" : null)">Entertainment</a>
            <a href="watch" aria-current="@(onWatch ? "page" : null)">Where to watch</a>
            <a href="videos" aria-current="@(onVideos ? "page" : null)">YouTube</a>
        </nav>

        <time class="header-clock" data-header-clock hidden aria-live="off">
            <span class="header-clock__date" data-clock-date></span>
            <span class="header-clock__date-compact" data-clock-date-compact></span>
            <span class="header-clock__time" data-clock-time></span>
        </time>

        <div class="header-actions">
            @* public.js fills in the saved count. *@
            <a class="saved-link" href="saved" aria-current="@(onSaved ? "page" : null)" title="Saved">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z"></path></svg>
                <span class="saved-link__label">Saved</span>
                <span class="saved-link__count" data-saved-count hidden></span>
            </a>
            @* Admin only: requests waiting and locked profiles, with a quick-look panel. *@
            <AuthorizeView><Authorized><AdminAlert /></Authorized></AuthorizeView>
            <a class="settings-link" href="settings" aria-current="@(onTeams ? "page" : null)">Settings</a>
            @* With profiles on: whose edition this is, and the way back to the picker. *@
            @if (Reader.Profile is { } me)
            {
                <a class="edition-chip" href="editions" style="--ed: @me.Color" aria-label="@($"{me.Name}’s edition · switch edition")">
                    <span class="edition-chip__tile" aria-hidden="true">@(me.Name.Trim() is { Length: > 0 } n ? char.ToUpperInvariant(n[0]).ToString() : "?")</span>
                    <span class="edition-chip__name" aria-hidden="true">@me.Name</span>
                </a>
            }
            @* Label and pressed state are kept in sync by public.js. *@
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-theme-toggle>
                <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
                <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            </button>
            <AuthorizeView>
                <Authorized><a class="admin-link" href="admin">Admin</a></Authorized>
                @* Only the household admin's profile is offered the sign-in (db/022); /login itself still works for anyone. *@
                <NotAuthorized>@if (ShowSignIn) { <a class="admin-link" href="login">Admin sign in</a> }</NotAuthorized>
            </AuthorizeView>

            @* Phones and tablets: a native disclosure, so the menu also works without JavaScript. *@
            <details class="mobile-nav" data-mobile-nav>
                <summary aria-label="Menu">
                    <svg class="mobile-nav__open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
                    <svg class="mobile-nav__close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
                </summary>
                <nav aria-label="Main" class="mobile-nav__links">
                    <a href="" aria-current="@(onHome ? "page" : null)">Home</a>
                    <div class="mobile-nav-group" role="group" aria-labelledby="mobile-news-heading">
                        <span class="nav-group-label" id="mobile-news-heading">News</span>
                        <div class="mobile-subnav">
                            <a href="news" aria-current="@(onNewsHome ? "page" : null)">News home</a>
                            <a href="news/all" aria-current="@(onNewsAll ? "page" : null)">All headlines</a>
                            <a href="news/kansas-city" aria-current="@(onKansasCity ? "page" : null)">Kansas City</a>
                        </div>
                    </div>
                    <div class="mobile-nav-group" role="group" aria-labelledby="mobile-sports-heading">
                        <span class="nav-group-label" id="mobile-sports-heading">Sports</span>
                        <div class="mobile-subnav">
                            <a href="sports" aria-current="@(onSportsHub ? "page" : null)">Sports home</a>
                            <a href="sports/news" aria-current="@((onSportsNews || onBasketballNews) ? "page" : null)">Headlines</a>
                            <a href="scoreboard" aria-current="@(onScoreboard ? "page" : null)">Scoreboard</a>
                            <a href="events" aria-current="@(onEvents ? "page" : null)">Competitions</a>
                            <a href="standings" aria-current="@(onStandings ? "page" : null)">Standings</a>
                            <a href="rankings" aria-current="@(onRankings ? "page" : null)">Top 25</a>
                            <a href="college" aria-current="@(onCollege ? "page" : null)">College Sports</a>
                            <a href="f1" aria-current="@(onF1 ? "page" : null)">F1</a>
                        </div>
                    </div>
                    <div class="mobile-nav-group" role="group" aria-labelledby="mobile-entertainment-heading">
                        <span class="nav-group-label" id="mobile-entertainment-heading">Entertainment</span>
                        <div class="mobile-subnav">
                            <a href="entertainment" aria-current="@(onEntertainmentHub ? "page" : null)">Entertainment home</a>
                            <a href="entertainment/news" aria-current="@((onEntertainmentNews || onTvFilmNews) ? "page" : null)">Headlines</a>
                            <a href="movies" aria-current="@(onMovies && !onDigital ? "page" : null)">Movies</a>
                            <a href="tv" aria-current="@(onTv ? "page" : null)">TV &amp; Streaming</a>
                            <a href="movies/digital" aria-current="@(onDigital ? "page" : null)">Digital releases</a>
                            <a href="box-office" aria-current="@(onBoxOffice ? "page" : null)">Box Office</a>
                        </div>
                    </div>
                    <a href="watch" aria-current="@(onWatch ? "page" : null)">Where to watch</a>
                    <a href="videos" aria-current="@(onVideos ? "page" : null)">YouTube</a>
                    <div class="mobile-nav-group" role="group" aria-labelledby="mobile-tools-heading">
                        <span class="nav-group-label" id="mobile-tools-heading">Tools</span>
                        <div class="mobile-subnav">
                            <a href="saved" aria-current="@(onSaved ? "page" : null)">Saved</a>
                            <a href="settings" aria-current="@(onTeams ? "page" : null)">Settings</a>
                            @if (Reader.Profile is { } reading) { <a href="editions">Switch edition (@reading.Name’s)</a> }
                            <button class="mobile-nav__theme" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-theme-toggle><span class="when-light">Dark mode</span><span class="when-dark">Light mode</span></button>
                            <AuthorizeView><Authorized><a href="admin">Administration</a></Authorized><NotAuthorized>@if (ShowSignIn) { <a href="login">Admin sign in</a> }</NotAuthorized></AuthorizeView>
                        </div>
                    </div>
                </nav>
            </details>
        </div>
    </header>

    <main class="page">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // With profiles off there's no one to tell apart, so everyone keeps the link, as before.
    private bool ShowSignIn => !Reader.Enabled || Reader.IsHouseholdAdmin;
}
