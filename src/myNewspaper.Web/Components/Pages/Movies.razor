@page "/movies"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject NavigationManager Navigation

<PageTitle>Movies · myNewspaper</PageTitle>
<PageHeading Section="entertainment" Title="Movies" Eyebrow="The release calendar" Description="" />

@* Release calendar as in the approved concept: a week of US releases, one column per day on desktop and one row per
   day on phones, with the next releases "Looking ahead". A search lists every collected date for the title instead. *@
<div class="mv-filters">
    <nav class="sec-pills sec-pills--desktop" aria-label="Release type">
        <a href="@ViewHref(null)" aria-current="@(Type is null ? "page" : null)">All releases</a>
        <a href="@ViewHref("theatrical")" aria-current="@(Type == "theatrical" ? "page" : null)">In theaters</a>
        <a href="@ViewHref("subscription")" aria-current="@(Type == "subscription" ? "page" : null)">Subscription streaming</a>
        <a href="movies/digital">Digital rental / purchase</a>
    </nav>
    <div class="mv-select"><MovieViewSelect Selected="@Type" Search="@Q" /></div>
    @if (Type == "theatrical")
    {
        <a class="nf-btn nf-btn--secondary theater-site-link" href="https://www.amctheatres.com/" target="_blank" rel="noopener noreferrer">
            <img src="images/brands/amc-theatres.svg" alt="" width="44" height="44" />
            <span>Visit AMC Theatres <span aria-hidden="true">↗</span></span>
        </a>
    }
    <span class="mv-updated">US releases@(listing.Updated is { } updated ? " · updated " + Dates.Time(updated) : "")</span>
</div>

<div class="mv-cols">
    @if (!string.IsNullOrWhiteSpace(Q))
    {
        <section class="mv-week" aria-labelledby="mv-week-title">
            <div class="ef-head"><h2 id="mv-week-title">Releases for “@QueryText.Term(Q)”</h2><a href="@ViewHref(Type)">Back to this week <span aria-hidden="true">→</span></a></div>
            @if (listing.Items.Count == 0) { <p class="ef-empty">No collected release dates match this title.</p> }
            <ul class="mv-list">
                @foreach (var movie in listing.Items)
                {
                    <li><span class="mv-list__date">@(movie.Date is { } date ? date.ToString("ddd, MMM d, yyyy", Us) : "Date to be announced")</span>@Release(movie)</li>
                }
            </ul>
        </section>
    }
    else
    {
        <section class="mv-week" aria-labelledby="mv-week-title">
            <div class="ef-head">
                <h2 id="mv-week-title">@(weekStart == CurrentWeekStart ? "This week" : weekStart == CurrentWeekStart.AddDays(7) ? "Next week" : "Week of " + weekStart.ToString("MMM d", Us)) <span class="mv-range">· @RangeLabel</span></h2>
                <span class="mv-pager">
                    @if (weekStart > CurrentWeekStart) { <a href="@WeekHref(weekStart.AddDays(-7))"><span aria-hidden="true">←</span> Previous week</a> }
                    <a href="@WeekHref(weekStart.AddDays(7))">Next week <span aria-hidden="true">→</span></a>
                </span>
            </div>
            <ol class="mv-days">
                @for (var offset = 0; offset < 7; offset++)
                {
                    var day = weekStart.AddDays(offset);
                    var releases = listing.Items.Where(m => m.Date == day).ToList();
                    <li class="mv-day @(day == today ? "mv-day--today" : null)">
                        <h3 class="mv-day__label"><span class="mv-day__dow">@day.ToString("ddd", Us)</span> <span class="mv-day__num">@day.Day</span></h3>
                        @if (releases.Count == 0) { <p class="mv-day__none">No releases</p> }
                        else
                        {
                            <ul class="mv-day__list">
                                @foreach (var movie in releases) { <li>@Release(movie)</li> }
                            </ul>
                        }
                    </li>
                }
            </ol>
            <p class="ef-note">@listing.Total @(listing.Total == 1 ? "release" : "releases") this week across enabled providers, including dates awaiting confirmation.</p>
        </section>
    }

    <aside class="mv-ahead" aria-labelledby="mv-ahead-title">
        <h2 id="mv-ahead-title" class="ef-label">Looking ahead</h2>
        @if (ahead.Count == 0) { <p class="ef-empty">No later releases are listed yet.</p> }
        @foreach (var movie in ahead)
        {
            <a class="ef-tv__item" href="@WatchHref(movie)">
                <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="ef-poster" />
                <span><b>@movie.Title</b><span class="ef-where">@(movie.Date?.ToString("ddd, MMM d", Us)) · @Where(movie)</span></span>
            </a>
        }
        <a class="ef-more" href="watch">Find streaming options in Where to watch <span aria-hidden="true">→</span></a>
    </aside>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Us = System.Globalization.CultureInfo.InvariantCulture;

    [SupplyParameterFromQuery(Name = "type")] private string? TypeText { get; set; }
    [SupplyParameterFromQuery(Name = "week")] private string? WeekText { get; set; }
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    private string? Type => TypeText is "theatrical" or "subscription" ? TypeText : null;

    private DateOnly today, weekStart;
    private DateOnly CurrentWeekStart => today.AddDays(-(int)today.DayOfWeek);
    private string RangeLabel => weekStart.Month == weekStart.AddDays(6).Month
        ? $"{weekStart.ToString("MMM d", Us)}–{weekStart.AddDays(6).Day}"
        : $"{weekStart.ToString("MMM d", Us)} – {weekStart.AddDays(6).ToString("MMM d", Us)}";
    private MoviesPage listing = new([], 0, [], null);
    private IReadOnlyList<MovieReleaseItem> ahead = [];

    private string ViewHref(string? type) => "movies" + (type is null ? "" : "?type=" + type);
    private string WeekHref(DateOnly start) => "movies?" + (Type is null ? "" : "type=" + Type + "&") +
        (start == CurrentWeekStart ? "" : "week=" + start.ToString("yyyy-MM-dd", Us));

    private static string WatchHref(MovieReleaseItem movie) => $"watch?kind=movie&q={Uri.EscapeDataString(movie.Title)}";
    private static string Where(MovieReleaseItem movie) => movie.Platform ?? MoviesQuery.Types.GetValueOrDefault(movie.Type, movie.Type);

    protected override async Task OnParametersSetAsync()
    {
        if (TypeText == "digital")
        {
            Navigation.NavigateTo("movies/digital", forceLoad: true);
            return;
        }
        today = Dates.Today;
        // Weeks run Sunday to Saturday; an unparseable or past week falls back to the current one.
        weekStart = DateOnly.TryParseExact(WeekText, "yyyy-MM-dd", Us, System.Globalization.DateTimeStyles.None, out var requested)
            && requested >= CurrentWeekStart
            ? requested.AddDays(-(int)requested.DayOfWeek)
            : CurrentWeekStart;
        await using var db = await Factory.CreateDbContextAsync();
        listing = string.IsNullOrWhiteSpace(Q)
            ? await MoviesQuery.GetAsync(db, weekStart, null, Type, null, null, take: 200, through: weekStart.AddDays(6))
            : await MoviesQuery.GetAsync(db, today, QueryText.Term(Q), Type, null, "all", take: 100);
        ahead = (await MoviesQuery.GetAsync(db, weekStart.AddDays(7), null, Type, null, null, take: 6)).Items
            .Where(m => m.Date is not null).ToList();
    }

    /// <summary>One release: poster, title (to Where to watch) and where it is showing, with a tickets or rent link.</summary>
    private RenderFragment Release(MovieReleaseItem movie) => __builder =>
    {
        var action = MovieCommerceQuery.Resolve(movie.Title, movie.Type, movie.MovieActionUrl, movie.MovieActionLabel, movie.MovieActionKind);
        <div class="mv-release">
            <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="ef-poster" />
            <span class="mv-release__text">
                <a class="mv-release__title" href="@WatchHref(movie)">@movie.Title</a>
                <span class="mv-release__where">@Where(movie)@(movie.DateStatus == "estimated" ? " · estimated" : "")</span>
                @if (action is not null)
                {
                    <a class="movie-commerce-action mv-release__action" href="@action.Url" target="_blank" rel="noopener noreferrer" aria-label="@(action.Label + " · " + movie.Title)">@action.Label <span aria-hidden="true">↗</span></a>
                }
            </span>
        </div>
    };
}
