@page "/watch"
@layout PublicLayout
@using myNewspaper.Web.Watching
@inject WatchCatalog Catalog
@inject FeedDates Dates
<PageTitle>Where to watch · myNewspaper</PageTitle>
<div class="watch-page">
<div class="mx-desktop tab-desktop">
<PageHeading Title="Where to watch" Eyebrow="MOVIES & TV" Description="Find US streaming, rental and purchase options for your next watch." />
<section class="watch-controls" aria-label="Search and browse titles">
<form method="get" action="watch" class="watch-search" role="search">
<label for="watch-query" class="sr-only">Movie or TV title</label>
<div class="watch-search-row"><input id="watch-query" name="q" value="@WatchCatalog.Term(Q)" maxlength="120" placeholder="Search movies and TV…" type="search" /><button class="nf-btn nf-btn--primary" type="submit">Search</button></div>
<input type="hidden" name="kind" value="@Media" />
<input type="hidden" name="services" value="@Selection" />
</form>
@if(!Searching){
<div class="watch-filters">
<nav class="watch-toggle" aria-label="Content type"><a href="@Url("featured",1,false)" aria-current="@(Featured?"page":null)">Featured</a><a href="@Url("movie",1,OnlyMine)" aria-current="@(Media=="movie"?"page":null)">Movies</a><a href="@Url("tv",1,OnlyMine)" aria-current="@(Media=="tv"?"page":null)">TV shows</a></nav>
@if(Selected.Length>0&&!Featured){<nav class="watch-toggle" aria-label="Services shown"><a href="@Url(Media,1,false)" aria-current="@(!OnlyMine?"page":null)">All services</a><a href="@Url(Media,1,true)" aria-current="@(OnlyMine?"page":null)">My services</a></nav>}
</div>
}
<div class="watch-mine">
@if(MyServices.Count>0){<ul class="watch-mine__logos" aria-label="My services">@foreach(var service in MyServices.Take(6)){<li title="@service.Name"><span aria-hidden="true">@service.Name[..1]</span>@if(service.Logo is {} logo){<img src="@logo" alt="" width="32" height="32" onerror="this.remove()" />}<span class="sr-only">@service.Name</span></li>}@if(MyServices.Count>6){<li class="watch-mine__more">+@(MyServices.Count-6)</li>}</ul>}
else if(Selected.Length>0){<span class="updated">@Selected.Length @(Selected.Length==1?"service":"services") selected</span>}
<a class="watch-services-link" href="settings#my-services"><span class="watch-services-label">@(Selected.Length>0?"Manage services":"Choose your services") →</span>@if(Selected.Length>0){<span class="watch-services-compact">Manage →</span>}</a>
</div>
@if(!Searching&&Media=="tv"){<p class="updated watch-controls-note">Active and upcoming series. Find ended shows with title search.</p>}
</section>
</div>
<div class="mx-phone tab-phone" data-phone-watch-ribbon>
<PhoneRibbon Title="Where to watch" Section="entertainment" Kicker="@($"Movies & TV · {Selected.Length} services chosen")">
<Extra>
<form method="get" action="watch" class="mx-ribbon__search" role="search">
<label for="watch-query-m">Movie or TV title</label><div><input id="watch-query-m" name="q" value="@WatchCatalog.Term(Q)" maxlength="120" placeholder="Movie or TV show…" type="search" /><button type="submit">Search</button></div>
<input type="hidden" name="kind" value="@Media" /><input type="hidden" name="services" value="@Selection" />
</form>
</Extra>
<ChildContent>
<form method="get" action="watch" class="mx-ribbon__field"><label for="watch-browse-m">Browse</label>
<select id="watch-browse-m" name="kind" onchange="this.form.requestSubmit()"><option value="featured" selected="@(Media=="featured")">Featured</option><option value="movie" selected="@(Media=="movie")">Movies</option><option value="tv" selected="@(Media=="tv")">TV shows</option></select>
<input type="hidden" name="services" value="@Selection" /><noscript><button class="nf-btn nf-btn--secondary" type="submit">Go</button></noscript>
</form>
</ChildContent>
</PhoneRibbon>
@if(!Featured){<nav class="mx-watch-options" aria-label="Services shown on phone"><a href="settings#my-services">@(Selected.Length>0?"Manage services":"Choose your services") →</a>@if(Selected.Length>0&&!Searching){<a href="@Url(Media,1,!OnlyMine)">@(OnlyMine?"Show all services":"Show my services only") →</a>}</nav>}
@if(!Searching&&Media=="tv"){<p class="mx-note">Active and upcoming series. Find ended shows with title search.</p>}
</div>
@if(Featured){
<PhoneWatch Movies="trendingMovies" Tv="trendingTv" NewMovies="newMovies" Services="servicesRow" SelectedCount="@Selected.Length" Selection="@Selection" />
<div class="mx-desktop tab-desktop">
<div class="watch-rows">
@if(Selected.Length>0){<WatchRow Id="watch-row-services" Heading="Popular on your services" Subtitle="@($"Movies and TV on {ServicesLabel}")" SeeAll="@Url("movie",1,true)" Listing="servicesRow" Empty="Nothing popular on your services right now. Try Manage services." />}
<WatchRow Id="watch-row-movies" Heading="Trending movies this week" Subtitle="Most watched and searched on TMDB" SeeAll="@($"watch?kind=movie&services={Selection}&sort=popular")" Listing="trendingMovies" />
<WatchRow Id="watch-row-tv" Heading="Trending TV this week" Subtitle="Series people are watching now" SeeAll="@($"watch?kind=tv&services={Selection}&sort=popular")" Listing="trendingTv" />
<WatchRow Id="watch-row-new" Heading="New movies you can watch" Subtitle="Released in the last 60 days with US viewing options" SeeAll="@($"watch?kind=movie&services={Selection}&sort=newest")" Listing="newMovies" />
</div>
</div>
}else{
<div class="watch-results-bar">
@if(Searching){<div class="watch-results-head"><h2 class="watch-results-heading">Results for “@WatchCatalog.Term(Q)”</h2><p class="updated">@if(!listing.Failed){<span>@ResultsMeta · </span>}<a href="@($"watch?kind={Media}&services={Selection}")">Clear search</a></p></div>}
<div class="watch-results-toolbar">
@if(!Searching){<p class="updated watch-results-count">@Summary</p>}
<form method="get" action="watch" class="watch-sort" data-watch-sort>
<input type="hidden" name="q" value="@WatchCatalog.Term(Q)" /><input type="hidden" name="kind" value="@Media" /><input type="hidden" name="page" value="@Page" /><input type="hidden" name="services" value="@Selection" />@if(OnlyMine){<input type="hidden" name="only" value="1" />}
<label for="watch-sort">Sort</label><select id="watch-sort" name="sort">@if(Searching){<option value="relevance" selected="@(SortMode=="relevance")">Best match</option>}<option value="services" selected="@(SortMode=="services")">Your services first</option><option value="title" selected="@(SortMode=="title")">Title A–Z</option><option value="newest" selected="@(SortMode=="newest")">Newest first</option><option value="popular" selected="@(SortMode=="popular")">Most popular</option></select><button class="nf-btn nf-btn--secondary" type="submit">Apply sort</button>
</form>
</div>
</div>
@if(listing.Failed){<p role="status">Title search is temporarily unavailable. Please try again shortly.</p>}
else if(listing.Items.Count==0){<p role="status">@(OnlyMine?"No titles on your services on this page. Try All services or another page.":"No matching titles with listed US viewing options on this page. Try another title or page.")</p>}
else{
<ul class="@(Searching ? "watch-results" : "watch-grid")">@foreach(var title in listing.Items){
@if(Searching){<WatchResultCard Title="title" />}else{<WatchPosterCard Title="title" />}}</ul>
@if(Searching&&listing.Items.Any(t=>t.Kind=="tv")){<p class="updated watch-results-note">TV listings cover the whole series; availability can vary by season.</p>}
}
@if(!listing.Failed&&listing.Pages>0){
<nav class="watch-tabs" aria-label="Result pages">@if(Page>1){<a href="@Url(Media,Page-1,OnlyMine)">← Previous</a>}<span>Page @Math.Clamp(Page,1,10)</span>@if(Page<listing.Pages){<a href="@Url(Media,Page+1,OnlyMine)">Next →</a>}</nav>
}
@if(listing.CanContinue){<p role="status">More titles need to be checked to finish this page. <a href="@Url(Media,Page,OnlyMine)" data-enhance-nav="false">Continue loading this page</a></p>}
}
<WatchCredits />
</div>
@code {
    [SupplyParameterFromQuery(Name="q")]public string? Q {get;set;}
    [SupplyParameterFromQuery(Name="kind")]public string? Type {get;set;}
    [SupplyParameterFromQuery(Name="page")]public int Page {get;set;}=1;
    [SupplyParameterFromQuery(Name="services")]public string? Services {get;set;}
    [SupplyParameterFromQuery(Name="service")]public int[]? Chosen {get;set;}
    [SupplyParameterFromQuery(Name="only")]public string? Only {get;set;}
    private int[] Selected=>WatchCatalog.ServiceIds(string.Join(",",new[]{Services??"",string.Join(",",Chosen??[])}));
    private string Selection=>string.Join(",",Selected);
    [SupplyParameterFromQuery(Name="sort")]public string? SortBy {get;set;}
    private string SortMode=>WatchCatalog.SortKey(SortBy,Searching);
    private string ResultsMeta=>$"{listing.Items.Count} {(listing.Items.Count==1?"title":"titles")} with US viewing options"+(listing.Pages>1?$" · Page {Page}":"");
    private bool Searching=>WatchCatalog.Term(Q).Length>0;
    private bool OnlyMine=>!Searching&&Selected.Length>0&&Only=="1";
    private string Media=>Type switch {"tv"=>"tv","movie"=>"movie",_=>"featured"};
    private bool Featured=>!Searching&&Media=="featured";
    private string ServicesLabel=>MyServices.Count is >0 and <=3 ? string.Join(MyServices.Count==2?" and ":", ",MyServices.Select(s=>s.Name)) : $"your {Selected.Length} services";
    private string Summary=>Searching?"Titles with listed US viewing options":$"{(Media=="tv"?"TV shows":"Movies")} {(OnlyMine?"on your services":"with US viewing options")} · Page {Page}";
    private WatchListing listing=new([],0),servicesRow=new([],0),trendingMovies=new([],0),trendingTv=new([],0),newMovies=new([],0);
    private IReadOnlyList<WatchCatalog.Service> MyServices=[];
    protected override async Task OnParametersSetAsync(){
        Page=Math.Clamp(Page,1,10);
        MyServices=Selected.Length>0?(await Catalog.Services()).Where(s=>Selected.Contains(s.Id)).ToList():[];
        if(Featured){
            var today=DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTime.UtcNow,Dates.Zone));
            var rows=await Task.WhenAll(Catalog.ServicesShelf(Selection),Catalog.TrendingShelf("movie",Selection),Catalog.TrendingShelf("tv",Selection),Catalog.NewMoviesShelf(today,Selection));
            (servicesRow,trendingMovies,trendingTv,newMovies)=(rows[0],rows[1],rows[2],rows[3]);
        }
        else listing=WatchCatalog.Sort(await Catalog.FilledPage(Searching?"multi":Media,Q,Page,Selection,OnlyMine),SortMode);
    }
    private string Url(string kind,int page,bool only)=>$"watch?kind={kind}&q={Uri.EscapeDataString(WatchCatalog.Term(Q))}&page={page}&services={Selection}&sort={SortMode}"+(only?"&only=1":"");
}
