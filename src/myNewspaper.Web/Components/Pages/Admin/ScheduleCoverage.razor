@page "/admin/schedule-coverage"
@rendermode InteractiveServer
@inject IDbContextFactory<WebScraperContext> Factory

<PageTitle>Schedule coverage</PageTitle>
<AdminContent>
    <AdminPageHeader Eyebrow="Overview" Title="Schedule coverage" />
<p>Check that enabled schedule feeds have a matching results follow. Disabled follows stay disabled.</p>
<p><a href="admin/results">Manage results follows</a> · <a href="admin/sports-event-types">Manage schedule feeds</a></p>
<button class="btn btn-outline-primary" disabled="@loading" @onclick="LoadAsync">Refresh</button>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (rows is null) { <p>Loading…</p> }
else
{
    <div class="table-responsive"><table class="table"><thead><tr><th>Schedule feed</th><th>Sport</th><th>Coverage</th><th>Results updated</th></tr></thead><tbody>
    @foreach (var row in rows)
    {
        <tr><td><a href="admin/sports-event-types/@row.FeedId/edit">@row.Feed</a></td><td>@row.Sport</td>
            <td>@row.Status @if (row.Error is not null) { <p class="text-danger">@row.Error</p> }</td><td>@Dates.Stamp(row.LastSynced)</td></tr>
    }
    </tbody></table></div>
}
</AdminContent>

@code {
    private IReadOnlyList<CoverageRow>? rows;
    private bool loading;
    private string? error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true; error = null;
        try { await using var db = await Factory.CreateDbContextAsync(); rows = await myNewspaper.Web.Data.ScheduleCoverage.GetAsync(db); }
        catch (Exception) { error = "Could not read coverage. Please try again."; }
        finally { loading = false; }
    }
}
