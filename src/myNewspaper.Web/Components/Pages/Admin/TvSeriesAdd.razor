@page "/admin/tv-series/new"
@rendermode InteractiveServer
<PageTitle>Follow a TV series</PageTitle>
<SeriesFollowForm InitialQuery="@InitialQuery" InitialYear="@InitialYear" />
@code {
    [SupplyParameterFromQuery(Name="q")]public string? InitialQuery {get;set;}
    [SupplyParameterFromQuery(Name="year")]public string? InitialYear {get;set;}
}
