@using System.Globalization
@* One area of the scraper status page (news sources, YouTube channels, TV series, movie releases, sports feeds).
   Rows without an editor show their name as plain text. Wide on phones: the table scrolls inside its card. *@
@if (Rows.Count == 0)
{
    <p class="adm-help">@Empty</p>
}
else
{
    <div class="adm-card adm-card--flush">
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="num">@ItemLabel</th>
                        @if (ShowUpcoming)
                        {
                            <th scope="col" class="num">Upcoming</th>
                        }
                        <th scope="col">Last refreshed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr class="@(!row.Enabled ? "is-off" : row.Level == HealthLevel.Problem ? "is-problem" : null)">
                            <td>
                                @if (EditBase is not null)
                                {
                                    <a class="adm-row-title" href="@EditBase/@row.Id/edit">@row.Name</a>
                                }
                                else
                                {
                                    <span class="adm-row-title">@row.Name</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Note))
                                {
                                    <span class="adm-row-sub">@row.Note</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Error))
                                {
                                    <span class="adm-row-error" title="@row.Error">@(row.Error.Length <= 160 ? row.Error : row.Error[..160] + "…")</span>
                                }
                            </td>
                            <td>
                                @if (row.Enabled)
                                {
                                    <StatusBadge Level="row.Level" />
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill--off">Disabled</span>
                                }
                            </td>
                            <td class="num">@row.ItemCount.ToString("N0", CultureInfo.InvariantCulture)</td>
                            @if (ShowUpcoming)
                            {
                                <td class="num">@row.Upcoming</td>
                            }
                            <td class="nowrap">@Dates.Stamp(row.LastSeen)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HealthRow> Rows { get; set; } = [];
    [Parameter, EditorRequired] public string ItemLabel { get; set; } = "";
    [Parameter] public string? EditBase { get; set; }
    [Parameter] public bool ShowUpcoming { get; set; }
    [Parameter] public string Empty { get; set; } = "";
}
