@page "/rankings"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject ILogger<Rankings> Log

<div class="@(CollegeSport is null ? "mx-desktop" : "mx-contents")">
@if (CollegeSport is null)
{
<PageTitle>Top 25 · myNewspaper</PageTitle>
<PageHeading Section="sports" Title="Top 25" Eyebrow="National polls" Description="" />
}
@if (CollegeSport is null && data.Sources.Count > 0)
{
    @* Polls as pills on desktop (as in the approved concept); the dropdown below serves phones. *@
    <nav class="sec-pills sec-pills--desktop st-leagues" aria-label="Polls">
        @foreach (var source in data.Sources)
        { <a href="@($"rankings?sourceId={source.Id}")" aria-current="@(data.Selected?.Id == source.Id ? "page" : null)">@source.DisplayName</a> }
    </nav>
    <form class="catselect st-select" method="get" action="@BasePath">
        @if (CollegeSport is not null) { <input type="hidden" name="sport" value="@CollegeHub.Resolve(CollegeSport).Key" /> }
        <label class="sr-only" for="ranking-source">Sport and poll</label>
        <select id="ranking-source" name="sourceId" onchange="this.form.requestSubmit()">
            @foreach (var source in data.Sources) { <option value="@source.Id" selected="@(data.Selected?.Id == source.Id)">@source.DisplayName</option> }
        </select>
        <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
    </form>
}
@if (data.AvailabilityError is { } unavailable)
{ <p class="empty" role="status">@unavailable <a href="@RetryHref">Try again</a></p> }
else if (data.Selected is null) { <p class="empty">No ranking sources are enabled for this selection.</p> }
else if (data.Poll is not { } poll || data.Teams.Count == 0) { <p class="empty">Rankings not available yet.</p> }
else
{
    @* Two columns of agate rows on desktop (1–13, 14–25), one list on phones. *@
    <div class="st-head">
        <h2>@poll.PollName · @poll.SeasonLabel</h2>
        <span class="mv-updated">@(RankingsQuery.OldPoll(poll, DateTime.UtcNow) ? "Latest available poll dated" : "Poll dated") @Dates.Published(poll.PublishedAtUtc) · first-place votes in parentheses · Big 12 highlighted · data via ESPN</span>
        @if (FeedQuery.SafeHref(poll.SourceUrl) is { } pollUrl) { <a class="rk-source" href="@pollUrl" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a> }
    </div>
    @if (RankingsQuery.Freshness(data.Selected, DateTime.UtcNow) is { } warning) { <p class="standing-status" role="status">@warning</p> }
    <div class="rk-cols">
        @foreach (var column in data.Teams.Chunk((data.Teams.Count + 1) / 2))
        {
            <ol class="rk-list" aria-label="@poll.PollName">
                <li class="rk-row rk-row--head" aria-hidden="true"><span>Rk</span><span>School</span><span>Rec</span><span>Move</span></li>
                @foreach (var team in column)
                {
                    var move = RankingsQuery.Movement(team);
                    <li class="rk-row @(team.IsBig12 == true ? "ranking-big12" : null)">
                        <b class="rk-row__rank">@(team.Rank?.ToString() ?? "—")</b>
                        <span class="rk-row__school">
                            @if (FeedQuery.SafeHref(team.TeamUrl) is { } teamUrl) { <a href="@teamUrl" target="_blank" rel="noopener noreferrer">@team.TeamName</a> }
                            else { <span>@team.TeamName</span> }
                            @if (team.FirstPlaceVotes is > 0) { <span class="poll-votes">(@team.FirstPlaceVotes)</span> }
                            @if (team.IsBig12 == true) { <span class="big12-badge">Big 12</span> }
                        </span>
                        <span class="rk-row__rec">@(team.Record ?? "—")</span>
                        <span class="rk-row__move @(move.StartsWith("Up") ? "rk-up" : move.StartsWith("Down") ? "rk-down" : move == "New" ? "rk-new" : null)" title="@($"Previous: {RankingsQuery.Previous(team)}")">@MoveLabel(move)</span>
                    </li>
                }
            </ol>
        }
    </div>
}

</div>
@if (CollegeSport is null) { <PhoneRankings Data="data" RetryHref="@RetryHref" /> }

@code {
    [Parameter] public string? CollegeSport { get; set; }
    private string BasePath => CollegeSport is null ? "rankings" : "college/rankings";
    [SupplyParameterFromQuery(Name = "sourceId")] private string? SourceId { get; set; }
    private RankingsPage data = new([], null, null, []);
    /// <summary>"Up 4" → "▲ 4", "Down 2" → "▼ 2"; "New" and "Unchanged" (—) as they are.</summary>
    private static string MoveLabel(string move) => move.StartsWith("Up ") ? "▲ " + move[3..] : move.StartsWith("Down ") ? "▼ " + move[5..] : move == "Unchanged" ? "—" : move;
    private string RetryHref => BasePath + (CollegeSport is not null ? "?sport=" + CollegeHub.Resolve(CollegeSport).Key + "&" : "?") + (data.Selected is { } selected ? $"sourceId={selected.Id}" : "");
    protected override async Task OnParametersSetAsync()
    {
        try { await using var db = await Factory.CreateDbContextAsync(); data = await RankingsQuery.GetAsync(db, StandingsQuery.ParseSourceId(SourceId), Log, Dates.Today, CollegeSport); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Rankings source read failed."); data = new([], null, null, [], "Rankings are temporarily unavailable."); }
    }
}
