@inject BoxScoresRepository BoxScores
@page "/college"
@page "/college/results"
@page "/college/standings"
@page "/college/rankings"
@page "/college/news"
@layout PublicLayout
@using myNewspaper.Web.Components.Events
@inject NavigationManager Nav
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject myNewspaper.Web.Scores.LeaguePhases RecordPhases
@inject ILogger<College> Log

<PageTitle>College Sports · @selected.Name · myNewspaper</PageTitle>
<PageHeading Title="College Sports" Eyebrow="CAMPUS SCOREBOARD" Description="Schedules, final scores, conference standings, national polls and conference news in one place." />
<form class="catselect college-sport-select" method="get" action="@BasePath">
    <label for="college-sport">Sport</label>
    <select id="college-sport" name="sport" onchange="this.form.requestSubmit()">
        @foreach (var sport in CollegeHub.Sports)
        { <option value="@sport.Key" selected="@(selected.Key == sport.Key)">@sport.Name</option> }
    </select>
    <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
</form>
<SectionSelect Id="college-view" Label="View" Current="@CollegeHub.Href(view, selected)"
    Choices="@(Tabs.Select(tab => new NavigationChoice(CollegeHub.Href(tab.Key, selected), tab.Label)).ToArray())" />
<p class="updated">@selected.Name · Big 12 schedule and standings coverage. Results include the college teams and conferences followed by this site; rankings are national polls when available.</p>
@if (view == "news")
{
    <Big12News Sport="@selected.Key" />
}
else if (view == "standings")
{
    <Standings CollegeSport="@selected.StandingsSport" @key="selected.Key" />
}
else if (view == "rankings")
{
    <Rankings CollegeSport="@selected.StandingsSport" @key="selected.Key" />
}
else if (error)
{ <p class="empty" role="status">College sports are temporarily unavailable. <a href="@CollegeHub.Href(view, selected)">Try again</a></p> }
else if (view == "schedule")
{
    <h2>@selected.Name schedule</h2>
    <p class="updated">Today through the next seven days. Start times use the site display timezone; unconfirmed times remain TBD.</p>
    @if (events.Items.Count == 0) { <p class="empty">No upcoming games are available for this sport in the next seven days.</p> }
    @if (updatedAt is { } refreshed) { <p class="updated">Schedule last updated @Dates.PublishedFull(refreshed)</p> }
    @if (events.Items.Count > 0) { <div class="games-head" aria-hidden="true"><span>Sport</span><span>Team / Away</span><span>Team / Home</span><span>Time</span><span>Location</span><span>Links</span></div> }
    <div class="groups">
    @foreach (var day in events.Items.GroupBy(e => e.EventDate))
    {
        <section class="group">
            <h3 class="group__bar">@FeedDates.LongDate(day.Key)</h3>
            <div class="standings-scroll" role="region" aria-label="College schedule" tabindex="0">
                <table class="games"><caption class="sr-only">@selected.Name · @FeedDates.LongDate(day.Key)</caption>
                    <thead><tr><th scope="col">Sport</th><th scope="col">Team / Away</th><th scope="col">Team / Home</th><th scope="col">Time</th><th scope="col">Location</th><th scope="col">Links</th></tr></thead>
                    <tbody>@foreach (var item in day) { <GameRow Item="item" Records="records" /> }</tbody>
                </table>
            </div>
        </section>
    }
    </div>
    @if (events.Total > events.Items.Count)
    {
        <nav class="tv-week" aria-label="College schedule pages">
            @if (pageIndex > 0) { <a href="@PageHref(pageIndex - 1)">← Earlier</a> }
            <span>Page @(pageIndex + 1) of @((events.Total + EventsQuery.Limit - 1) / EventsQuery.Limit)</span>
            @if ((pageIndex + 1) * EventsQuery.Limit < events.Total) { <a href="@PageHref(pageIndex + 1)">Later →</a> }
        </nav>
    }
}
else
{
    <h2>@selected.Name results</h2>
    <nav class="tv-week" aria-label="College result dates">
        @if (resultDay == Dates.Today) { <a href="@DayHref(Dates.Today.AddDays(-1))">← Yesterday</a> }
        <span>@FeedDates.LongDate(resultDay)</span>
        @if (resultDay < Dates.Today) { <a href="@DayHref(Dates.Today)">Today →</a> }
    </nav>
    @if (resultDay == Dates.Today) { <p class="updated" data-results-refresh>Final scores refresh about every 10 minutes. This page checks for updates automatically.</p> }
    @if (updatedAt is { } synced) { <p class="updated">Results last updated @Dates.PublishedFull(synced)</p> }
    @if (results.Items.Count == 0) { <p class="empty">No finished games are available for this sport on this date.</p> }
    else
    {
        <div class="results-head" aria-hidden="true"><span>Competition</span><span>Away</span><span>Score</span><span>Home</span><span>Venue</span></div>
        <div class="results standings-scroll" role="region" aria-label="College results" tabindex="0">
            <table class="games"><caption class="sr-only">@selected.Name results</caption>
                <thead><tr><th scope="col">Competition</th><th scope="col">Away</th><th scope="col">Score</th><th scope="col">Home</th><th scope="col">Venue</th></tr></thead>
                <tbody>@foreach (var item in results.Items) { <ResultRow Item="item" Records="records" BoxLabels="boxLabels" /> }</tbody>
            </table>
        </div>
        @if (results.Total > results.Items.Count) { <p class="count">Showing the latest @results.Items.Count of @results.Total results.</p> }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "sport")] private string? Sport { get; set; }
    [SupplyParameterFromQuery(Name = "day")] private string? Day { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? Page { get; set; }
    private static readonly (string Key, string Label)[] Tabs = [("schedule", "Schedule"), ("results", "Results"), ("standings", "Standings"), ("rankings", "Rankings"), ("news", "News")];
    private CollegeSport selected = CollegeHub.Sports[0];
    private string view = "schedule";
    private string BasePath => view == "schedule" ? "college" : "college/" + view;
    private EventsPage events = new([], 0);
    private ResultsPage results = new([], 0);
    private IReadOnlyDictionary<string,string> boxLabels = new Dictionary<string,string>();
    private TeamRecords records = TeamRecords.Empty;
    private bool error;
    private DateTime? updatedAt;
    private int pageIndex;
    private DateOnly resultDay;
    private string PageHref(int page) => CollegeHub.Href(view, selected) + "&page=" + page;
    private string DayHref(DateOnly day) => CollegeHub.Href("results", selected) + $"&day={day:yyyy-MM-dd}";

    protected override async Task OnParametersSetAsync()
    {
        selected = CollegeHub.Resolve(Sport);
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        view = path.Split('/').Last() is "results" or "standings" or "rankings" or "news" ? path.Split('/').Last() : "schedule";
        error = false;
        updatedAt = null;
        if (view is "standings" or "rankings" or "news") return;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            records = await TeamRecords.LoadAsync(db, Dates.Today, RecordPhases);
            if (view == "schedule")
            {
                pageIndex = int.TryParse(Page, out var page) ? Math.Clamp(page, 0, 10000) : 0;
                events = await EventsQuery.GetUpcomingAsync(db, Dates.Today, selected.StandingsSport, null,
                    provider: "big12", to: Dates.Today.AddDays(7), offset: pageIndex * EventsQuery.Limit);
                updatedAt = await db.SportsEvents.AsNoTracking().Where(e => e.ProviderKey == "big12" && e.Sport == selected.StandingsSport).MaxAsync(e => (DateTime?)e.LastSeenAt);
                pageIndex = Math.Min(pageIndex, Math.Max(0, (events.Total - 1) / EventsQuery.Limit));
            }
            else
            {
                resultDay = DateOnly.TryParseExact(Day, "yyyy-MM-dd", out var day) && day >= Dates.Today.AddDays(-1) && day <= Dates.Today ? day : Dates.Today;
                updatedAt = await db.ResultFollows.AsNoTracking().Where(f => f.Enabled && f.League == selected.League).MaxAsync(f => f.LastSyncedAt);
                results = await ResultsQuery.GetResultsAsync(db, null, window: ResultsWindow.ForDay(resultDay, Dates.Zone), collegeLeague: selected.League);
                boxLabels = await BoxScores.AvailableAsync(results.Items.Select(i=>new BoxIdentity(i.Sport ?? "",i.League ?? "",i.EventId)));
            }
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        { Log.LogError(ex, "College hub read failed for {Sport} {View}.", selected.Key, view); error = true; }
    }
}
