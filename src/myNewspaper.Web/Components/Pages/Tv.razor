@page "/tv"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates

<PageTitle>TV &amp; Streaming · myNewspaper</PageTitle>
<PageHeading Title="TV &amp; Streaming" Eyebrow="YOUR EPISODE CALENDAR" Description="Upcoming original releases for the series we follow." />
<details class="tracked-series"><summary>Tracked series · @schedule.Shows.Count</summary><ul class="agenda-list">@foreach (var series in schedule.Shows) { <li class="agenda-item"><h3><a href="@($"tv?show={series.Id}")">@series.Title</a></h3></li> }</ul></details>
<nav class="tv-week" aria-label="Episode calendar dates">
    <span>@start.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture) – @start.AddDays(6).ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
    <a class="nf-btn nf-btn--secondary" href="@Href(start.AddDays(7))">Next →</a>
    <a href="tv">Today onward</a>
</nav>
<p class="count">@schedule.Total @(schedule.Total == 1 ? "episode" : "episodes")</p>
@if (schedule.Updated is { } updated) { <p class="updated">Schedules last refreshed @Dates.PublishedFull(updated)</p> }
@if (schedule.Items.Count == 0)
{
    <p class="empty">@(schedule.Shows.Count == 0 ? "No series are followed yet." : "No episodes scheduled for this date range.")</p>
}
@foreach (var group in schedule.Items.GroupBy(e => e.Date))
{
    <section class="tv-day">
        <h2>@FeedDates.LongDate(group.Key)</h2>
        <ul class="tv-episodes">
            @foreach (var episode in group)
            {
                <li class="tv-episode">
                    <div class="tv-poster" aria-hidden="true">
                        @if (EventsText.LogoUrl(episode.Poster) is { } poster)
                        { <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" /> }
                    </div>
                    <div class="tv-episode__body">
                        <p class="movie-kind">@(episode.Platform ?? "Network not announced")</p>
                        <h3>@episode.SeriesTitle</h3>

                        <p class="tv-episode__name">
                            @(episode.Special ? "Special" : episode.Season is { } season && episode.Number is { } number ? $"S{season:00} · E{number:00}" : "Episode")
                            @if (!string.IsNullOrWhiteSpace(episode.Title)) { <span> · @episode.Title</span> }
                        </p>
                        <p class="movie-meta">
                            @if (episode.StartsUtc is { } time) { <span>@Dates.TimeWithOffset(time)</span> }
                            else { <span>Release date only · Time not confirmed</span> }
                        </p>
                        @if (FeedQuery.SafeHref(episode.Url) is { } href)
                        { <a class="movie-source" href="@href" target="_blank" rel="noopener noreferrer">Episode details on TVmaze ↗</a> }
                    </div>
                </li>
            }
        </ul>
    </section>
}
@if (schedule.Total > schedule.Items.Count) { <p class="count">Showing @schedule.Items.Count of @schedule.Total episodes. Use the date navigation to browse other weeks.</p> }
@if (schedule.Unannounced.Count > 0)
{
    <section class="tv-unannounced"><h2>Next release not announced</h2><ul>@foreach (var name in schedule.Unannounced) { <li>@name</li> }</ul></section>
}
<p class="updated tv-attribution">
    Episode data and images from <a href="https://www.tvmaze.com" target="_blank" rel="noopener noreferrer">TVmaze</a>,
    licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>.
    Dates without confirmed times remain date-only; confirmed times are converted to @Dates.Zone.Id.
    Original release schedules do not guarantee availability on your local streaming service.
</p>

@code {
    [SupplyParameterFromQuery(Name = "from")] private string? From { get; set; }
    [SupplyParameterFromQuery(Name = "show")] private string? Show { get; set; }
    private DateOnly start;
    private TvSchedule schedule = new([], 0, [], [], null);
    protected override async Task OnParametersSetAsync()
    {
        var today = Dates.Today;
        start = DateOnly.TryParseExact(From, "yyyy-MM-dd", out var parsed)
            && parsed.Year <= 9998 && parsed >= today ? parsed : today;
        await using var db = await Factory.CreateDbContextAsync();
        schedule = await TvQuery.GetAsync(db, Dates, start, int.TryParse(Show, out var show) && show > 0 ? show : null);
    }
    private string Href(DateOnly date) => $"tv?from={date:yyyy-MM-dd}" + (int.TryParse(Show, out var show) && show > 0 ? $"&show={show}" : "");
}
