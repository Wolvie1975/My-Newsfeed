@page "/news"
@page "/sports"
@page "/entertainment"
@layout PublicLayout
@inject NavigationManager Nav

<PageTitle>@Title · myNewspaper</PageTitle>
@* Each section front loads its own data (NewsFront, EntertainmentFront, SportsFront). *@
@if (Section == "news") {
    @* NewsFront draws its own heading: its tabs come from the database. *@
    <NewsFront />
} else if (Section == "entertainment") {
    <div class="mx-desktop tab-desktop"><PageHeading Section="entertainment" Title="Entertainment" Eyebrow="Stories, releases and what to watch next" Description="" /></div>
    <EntertainmentFront />
} else {
    @* Phones: SportsFront's ribbon replaces this heading. *@
    <div class="mx-desktop tab-desktop"><PageHeading Section="sports" Title="Sports" Eyebrow="Your daily overview" Description="" /></div>
    <SportsFront />
}

@code {
    private string Section => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/').ToLowerInvariant();
    private string Title => Section switch { "news" => "News", "entertainment" => "Entertainment", _ => "Sports" };
}
