@page "/"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject myNewspaper.Web.Profiles.ProfileContext Reader
@inject NavigationManager Nav
@inject ILogger<Home> Log
@inject ScoreboardRepository Scoreboard
@inject LocalWeather Weather
@using myNewspaper.Web.Components.Feed

<PageTitle>Home · myNewspaper</PageTitle>

@* Static (non-interactive) page: a small slice of News, Sports Events and Videos, each with a "View all" link.
   Today, the greeting and the date are all decided on the server in the display zone (Central), so every visitor sees
   the same day and nothing here needs JavaScript. *@

@* Broadsheet front page. From 1024px (desktop) the markup is the layout: a masthead with the forecast, the title
   and Coming up; Where to watch as a full-width strip; three ruled columns; a "More from today" band. Phones show one
   column whose order comes from CSS (Watch first, then the forecast, Today & Tonight, the lead and headlines). Today,
   the greeting and the date are decided on the server in the display zone (Central). *@

<p class="empty" data-home-empty hidden>All home sections are hidden. <button type="button" data-home-reset class="nf-btn nf-btn--secondary">Restore default homepage</button></p>
<p class="updated" data-personal-status role="status"></p>
<div class="mx-desktop">
<div class="bs-home" data-home-grid>

    <div class="bs-masthead">
        <div class="bs-title">
            <p class="bs-title__name" aria-hidden="true">
                <svg class="bs-title__mark" viewBox="0 0 64 64" width="64" height="64" focusable="false"><rect width="64" height="64" rx="14" class="bs-mark-tile" /><path d="M12 8h29l11 11v37H12z" class="bs-mark-page" /><path d="M41 8v11h11z" class="bs-mark-fold" /><g class="bs-mark-n"><rect x="16" y="12" width="21" height="5.5" rx="1" /><rect x="16" y="21" width="32" height="1.4" /><rect x="16" y="25.5" width="32" height="4.5" rx="1" /><rect x="16" y="33.5" width="15" height="12" rx="1" fill-opacity=".35" /><rect x="34" y="33.5" width="14" height="2.2" rx="1" /><rect x="34" y="38.3" width="14" height="2.2" rx="1" /><rect x="34" y="43.1" width="10" height="2.2" rx="1" /><rect x="16" y="48.5" width="32" height="2.2" rx="1" /></g></svg>myNewspaper
            </p>
            <h1 class="bs-title__greeting">@Dates.Greeting(nowUtc)</h1>
            <p class="bs-title__date">@Dates.TodayLabel(nowUtc) · Kansas City edition</p>
            <a class="nf-btn nf-btn--secondary home-refresh" href="@Nav.Uri" data-enhance-nav="false" aria-label="Refresh homepage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5" /><path d="M4 17v-5h5" /><path d="M6.1 7a7 7 0 0 1 11.6-2L20 8M4 16l2.3 3A7 7 0 0 0 17.9 17" /></svg>
                Refresh
            </a>
        </div>

        @if (weather is { Periods.Count: > 0 } forecast)
        {
            <section class="bs-glance" aria-label="Kansas City weather">
                <div class="bs-glance__weather">
                    <h2 class="bs-glance__title">Kansas City weather</h2>
                    <a class="d-more" href="news/kansas-city">Kansas City <span aria-hidden="true">→</span></a>
                    <ul class="bs-glance__periods">
                        @foreach (var period in forecast.Periods.Take(4))
                        {
                            <li><span class="bs-glance__name">@period.Name</span><WeatherIcon Summary="@period.Summary" IsDaytime="@period.IsDaytime" /><span class="bs-glance__reading"><b>@period.Temperature°</b> @period.Summary</span></li>
                        }
                    </ul>
                </div>
            </section>
        }

        <section class="bs-ear bs-live" aria-labelledby="h-home-live" data-home-live>
            <h2 class="bs-ear__title" id="h-home-live">@(liveGames.Count > 0 ? "Live now" : "Coming up")</h2>
            <a class="d-more" href="scoreboard">Scoreboard <span aria-hidden="true">→</span></a>
            @if (liveGames.Count == 0 && upcomingGames.Count == 0)
            {
                <p class="d-empty">No games on today’s scoreboard.</p>
            }
            <ul class="bs-live__list">
                @foreach (var game in liveGames.Count > 0 ? liveGames : upcomingGames)
                {
                    <li>
                        <a href="scoreboard">
                            <span class="bs-live__score">@LiveLine(game)</span>
                            <span class="bs-live__clock">@ScoreboardPanel.CompetitionLabel(game.Sport, game.League) · @(game.Active ? game.StatusText ?? game.DisplayClock ?? "Live" : game.StartsAtUtc is { } start ? Dates.Time(start) : "Time TBD")</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    </div>

    <section data-home-section="watch" class="bs-ear bs-watch" aria-labelledby="h-home-watch">
        <h2 class="bs-ear__title" id="h-home-watch">Where to watch</h2>
        <form method="get" action="watch" class="watch-search bs-watch__search" role="search" aria-label="Where to watch search">
            <label for="home-watch-query">Movie or TV title</label>
            <div class="watch-search-row">
                <input id="home-watch-query" name="q" type="search" maxlength="120" placeholder="Search a movie or TV show…" required />
                <button class="nf-btn nf-btn--primary" type="submit">Search</button>
            </div>
        </form>
    </section>

    <div class="bs-sheet">
    <div class="bs-front">
        <div class="bs-col bs-col--left">
            <section data-home-section="sports" class="d-card d-today bs-tonight" aria-labelledby="h-tonight">
                <div class="d-card__head"><h2 class="d-card__title" id="h-tonight">Today &amp; Tonight</h2><a class="d-more" href="events">All games <span aria-hidden="true">→</span></a></div>
                @if (tonight.Count == 0) { <p class="d-empty">No remaining games today. View All games for upcoming fixtures.</p> }
                <p class="d-empty" data-home-teams-empty hidden>No remaining games match your selected teams. <a href="events">Browse all games</a>.</p>
                @if (tonight.Count > 0) { <p class="bs-agate__note">All times @(Dates.ZoneLabel ?? "local") · TV in bold</p> }
                <ul class="bs-agate">
                    @foreach (var (heading, items) in TodayTonight.Groups(tonight, Dates))
                    {
                        <li class="bs-agate__group">
                            <h3 class="bs-agate__heading">@heading</h3>
                            <ul>
                            @foreach (var item in items)
                            {
                                <li class="bs-agate__row" data-home-team-item data-sports-teams="@SportsTeamPreferences.Keys(item.SchoolName, item.OpponentName)">
                                    @if (item.StartsUtc is { } starts)
                                    {
                                        var (clock, half) = Dates.ClockParts(starts);
                                        <span class="bs-agate__time">@clock<span class="bs-agate__half">@(" " + half)</span></span>
                                    }
                                    else { <span class="bs-agate__time">@item.TimeLabel</span> }
                                    <span class="bs-agate__match">
                                        @if (item.Url is not null)
                                        { <a href="@item.Url" target="_blank" rel="noopener noreferrer"><TonightMatchup Item="item" /></a> }
                                        else { <TonightMatchup Item="item" /> }
                                        <span class="bs-agate__kind"><span class="bs-agate__sport">@item.Kind</span>@if (item.Location is not null) { <span class="bs-agate__venue"> · @EventsText.SplitLocation(item.Location).Item1</span> }</span>
                                    </span>
                                    @* The network doubles as the stream link, so phones keep one tap target per row. *@
                                    @if (item.StreamUrl is not null)
                                    {
                                        <a class="bs-agate__tv bs-agate__tv--stream" href="@item.StreamUrl" target="_blank" rel="noopener noreferrer"
                                           aria-label="Watch stream@(item.Tv is not null ? " on " + item.Tv : "")"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1.2v7.6L8.6 5z" fill="currentColor" /></svg>@(item.Tv ?? "Watch")</a>
                                    }
                                    else if (item.Tv is not null)
                                    {
                                        <span class="bs-agate__tv">@item.Tv</span>
                                    }
                                </li>
                            }
                            </ul>
                        </li>
                    }
                </ul>
                @if (FoldF1)
                {
                    <myNewspaper.Web.Components.F1.F1Home Data="homeF1" Error="@homeF1Error" NowUtc="nowUtc" Embedded="true" />
                }
            </section>
        </div>

        <div class="bs-col bs-col--main">
            <HomeLeadStory Snapshot="@lead" />
            <HomeHeadlineShelf SectionKey="news" Title="More headlines" HeadingId="h-news" Href="news/all"
                               CssClass="d-news" Stories="@headlineStories" ShowCategory="true" EmptyText="More headlines will appear as new stories arrive." />
        </div>

        <div class="bs-col bs-col--side">
            <HomeLatestVideo Item="@latestVideo" Failed="@latestVideoFailed" />
            @if (HomeBoxOfficeSchedule.ShowResults(Dates.TodayAt(nowUtc)))
            {
                <HomeBoxOfficeResults Rows="homeBoxOffice" Weekend="@HomeBoxOfficeSchedule.ResultsWeekend(Dates.TodayAt(nowUtc))" Failed="homeBoxOfficeFailed" />
            }
            else
            {
                <BoxOfficeForecastSection HomeCard="true" Rows="@(homeForecasts.Movies.Where(m => m.Kind == BoxOfficeForecastQuery.Preview).ToList())"
                    Source="@(homeForecasts.Sources.SingleOrDefault(s => s.Kind == BoxOfficeForecastQuery.Preview))" UtcNow="@nowUtc" />
            }
            <HomeHeadlineShelf SectionKey="sports-news" Title="Sports headlines" HeadingId="h-sports-headlines" Href="sports/news"
                               CssClass="d-sports-headlines" Stories="@sportsStories" />
        </div>
    </div>

    <h2 class="bs-band">More from today</h2>

    <div class="bs-more">
        <div class="bs-col bs-col--left">
            <section data-home-section="scoreboard" class="d-card d-scoreboard" aria-labelledby="h-home-scoreboard">
                <div class="d-card__head"><h2 class="d-card__title" id="h-home-scoreboard">Scoreboard</h2><a class="d-more" href="scoreboard">View all <span aria-hidden="true">→</span></a></div>
                <ScoreboardPanel Compact="true" SportFilter="true" CompactShow="@ScoreboardShow" />
            </section>
            <HomeRankings Data="homeRankings" />
        </div>

        <div class="bs-col bs-col--main">
            <HomeHeadlineShelf SectionKey="entertainment-news" Title="Entertainment headlines" HeadingId="h-entertainment-headlines" Href="entertainment/news"
                               CssClass="d-entertainment-headlines" Stories="@entertainmentStories" />
            <section data-home-section="videos" class="d-card d-vids" aria-labelledby="h-vids">
                <div class="d-card__head">
                    <h2 class="d-card__title" id="h-vids">Latest videos <span class="d-card__count">Up to <span class="home-limit-desktop">10</span><span class="home-limit-mobile">5</span> channels · rotates hourly</span></h2>
                    <a class="d-more" href="videos">View all <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a>
                </div>
                @if (videos.Count == 0)
                {
                    <p class="d-empty">No videos yet. Check back soon.</p>
                }
                else
                {
                    <ul class="d-list">
                        @foreach (var video in videos)
                        {
                            var href = FeedQuery.SafeHref(video.Url);
                            var picture = VideosText.Thumbnail(video.ThumbnailUrl, video.VideoId);
                            var views = VideosText.Views(video.ViewCount);
                            <li class="d-vid">
                                <a class="d-thumb" href="@href" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                                    <span class="d-thumb__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m21 16-5-5-8 9"></path></svg></span>
                                    @if (picture is not null)
                                    {
                                        <img src="@picture" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
                                    }
                                    <span class="play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z"></path></svg></span>
                                </a>
                                <div class="d-vid__body">
                                    <p class="d-vid__chan"><span class="d-mark" aria-hidden="true">@VideosText.Initial(video.ChannelName)</span><span class="d-vid__name">@video.ChannelName</span></p>
                                    <h3 class="d-vid__title">
                                        @if (href is not null)
                                        {
                                            <a href="@href" target="_blank" rel="noopener noreferrer">@video.Title</a>
                                        }
                                        else
                                        {
                                            @video.Title
                                        }
                                    </h3>

                                    <p class="d-vid__meta">
                                        <time datetime="@video.PublishedAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")" title="@Dates.PublishedFull(video.PublishedAt)">@Dates.Published(video.PublishedAt)</time>
                                        @if (views is not null)
                                        {
                                            <span aria-hidden="true">·</span>
                                            <span>@views</span>
                                        }
                                        <span class="video-actions">
                                            <myNewspaper.Web.Components.Feed.ShareButton Url="@video.Url" Title="@video.Title" Kind="video" />
                                            <myNewspaper.Web.Components.Feed.VideoSaveButton Item="video" />
                                        </span>
                                    </p>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <div class="bs-col bs-col--side">
            <section data-home-section="tv" class="d-card d-episodes" aria-labelledby="h-tv">
                <div class="d-card__head">
                    <h2 class="d-card__title" id="h-tv">Today’s episodes <span class="d-card__count">@episodes.Count @(episodes.Count == 1 ? "episode" : "episodes")</span></h2>
                    <a class="d-more" href="tv">View calendar <span aria-hidden="true">→</span></a>
                </div>
                <p class="bs-episodes-count">@episodes.Count @(episodes.Count == 1 ? "episode" : "episodes")</p>
                @if (episodes.Count == 0)
                {
                    <p class="d-empty">No new episodes from followed series today.</p>
                }
                else
                {
                    <ul class="d-list d-tv__list">
                        @foreach (var group in episodes.GroupBy(e => e.ShowId))
                        {
                            var series = group.First();
                            <li class="d-tv__show">
                                <div class="tv-poster" aria-hidden="true">
                                    @if (EventsText.LogoUrl(series.Poster) is { } poster)
                                    { <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" /> }
                                </div>
                                <div class="d-tv__body">
                                    <p class="movie-kind">@(series.Platform ?? "Network not announced")</p>
                                    <h3 class="d-vid__title">@series.SeriesTitle</h3>
                                    <ul class="d-tv__episodes">
                                        @foreach (var episode in group)
                                        {
                                            var label = episode.Special ? "Special" : episode.Season is { } season && episode.Number is { } number ? $"S{season:00} E{number:00}" : "Episode";
                                            <li>
                                                @if (FeedQuery.SafeHref(episode.Url) is { } link)
                                                { <a href="@link" target="_blank" rel="noopener noreferrer">@label · @(episode.Title ?? "Title to be announced")</a> }
                                                else { <span>@label · @episode.Title</span> }
                                                <span class="movie-meta">@(episode.StartsUtc is { } time ? Dates.TimeWithOffset(time) : "Time not confirmed")</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }
                    </ul>
                }
                <p class="d-tv__credit">Episode data and images: <a href="https://www.tvmaze.com" target="_blank" rel="noopener noreferrer">TVmaze</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. Date-only releases retain their original date; confirmed times use @Dates.Zone.Id.</p>
            </section>
            @if (ShowTheatrical)
            {
            <section data-home-section="movies" class="d-card d-movies" aria-labelledby="h-movies">
                <div class="d-card__head">
                    <h2 class="d-card__title" id="h-movies">Friday theater releases</h2>
                    <a class="d-more" href="movies?type=theatrical">View all <span aria-hidden="true">→</span></a>
                </div>
                @if (movies.Count == 0)
                {
                    <p class="d-empty">No theater releases announced for this Friday yet.</p>
                }
                else
                {
                    <ul class="d-list" tabindex="0" aria-label="This Friday’s theater releases">
                        @foreach (var movie in movies)
                        {
                            var href = FeedQuery.SafeHref(movie.SourceUrl);
                            <li class="d-movie">
                                <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="d-movie__poster" />
                                <div class="d-movie__body">
                                    @if (movie.Date is { } date)
                                    {
                                        <p class="d-movie__date"><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>@(movie.DateStatus == "estimated" ? " · Estimated" : "")</p>
                                    }
                                    <h3 class="d-vid__title">
                                        @if (href is not null)
                                        {
                                            <a href="@href" target="_blank" rel="noopener noreferrer">@movie.Title</a>
                                        }
                                        else
                                        {
                                            @movie.Title
                                        }
                                    </h3>
                                    <p class="d-vid__meta">@string.Join(" · ", new[] { movie.Certification, movie.Runtime is { } runtime ? $"{runtime} min" : null, movie.ReRelease ? "Re-release" : null }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                                    <MovieCommerceAction Item="movie" />
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
            }

            <section data-home-section="digital" class="d-card d-movies d-digital" aria-labelledby="h-digital">
                <div class="d-card__head">
                    <h2 class="d-card__title" id="h-digital">Upcoming Digital / VOD
                        @if (digitalData?.Selected is { } source)
                        {
                            <span class="d-card__count">@source.Name · From today onward</span>
                        }
                    </h2>
                    <a class="d-more" href="movies/digital">View all <span aria-hidden="true">→</span></a>
                </div>
                @if (digitalData?.Selected is { } digitalSource)
                {
                    @if (!string.IsNullOrWhiteSpace(digitalSource.LastError)) { <p class="updated">Latest collection failed; showing previously collected releases when available.</p> }
                }
                @if (digitalMovies.Count == 0)
                {
                    <p class="d-empty">No confirmed digital releases from the selected source from today onward.</p>
                }
                else
                {
                    <ul class="d-list" tabindex="0" aria-label="Upcoming Digital / VOD">
                        @foreach (var movie in digitalMovies)
                        {
                            var href = FeedQuery.SafeHref(movie.SourceUrl);
                            <li class="d-movie">
                                <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="d-movie__poster" />
                                <div class="d-movie__body">
                                    @if (movie.Date is { } date)
                                    {
                                        <p class="d-movie__date"><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>@(movie.DateStatus == "estimated" ? " · Estimated" : "")</p>
                                    }
                                    <h3 class="d-vid__title">
                                        @if (href is not null)
                                        {
                                            <a href="@href" target="_blank" rel="noopener noreferrer">@movie.Title</a>
                                        }
                                        else
                                        {
                                            @movie.Title
                                        }
                                    </h3>
                                    <p class="d-vid__meta">VOD / Digital · @movie.Source</p>
                                    <p class="d-vid__meta">@string.Join(" · ", new[] { movie.Certification, movie.Runtime is { } runtime ? $"{runtime} min" : null, movie.ReRelease ? "Re-release" : null }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                                    <MovieCommerceAction Item="movie" />
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
    </div>
</div>
</div>

@* Phones: the folded front (docs/mobile-refresh-handoff.md), from the same data. Its sections carry the same
   data-home-section keys, so a section hidden in Settings disappears here too. *@
<div class="mx-phone" data-home-grid>
    <PhoneRibbon Kicker="@($"{Dates.TodayAt(nowUtc).ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture)} · Kansas City edition")" Title="@Dates.Greeting(nowUtc)">
        <Extra>
            @if (weather is { Periods.Count: > 0 } forecast)
            {
                <a class="mx-weather" href="news/kansas-city">
                    <span class="sr-only">Kansas City weather:</span>
                    @foreach (var period in forecast.Periods.Take(4))
                    {
                        <span class="mx-weather__period"><span class="mx-weather__name">@ShortPeriod(period.Name)</span><WeatherIcon Summary="@period.Summary" IsDaytime="@period.IsDaytime" /><b class="mx-weather__temp">@period.Temperature°</b><span class="mx-weather__summary">@period.Summary</span></span>
                    }
                </a>
            }
        </Extra>
        <ChildContent>
            <form method="get" action="watch" class="mx-ribbon__search" role="search" aria-label="Where to watch search" data-home-section="watch">
                <label for="home-watch-query-m">Where to watch</label>
                <div>
                    <input id="home-watch-query-m" name="q" type="search" maxlength="120" placeholder="Movie or TV show…" required />
                    <button type="submit">Search</button>
                </div>
            </form>
        </ChildContent>
    </PhoneRibbon>

    @if (lead.Article is { } top)
    {
        <article class="mx-block" data-article-story="feature" data-image-layout="compact" aria-label="Top story" data-home-section="lead">
            @if (FeedQuery.SafeHref(top.ImageUrl) is { } image)
            {
                <div class="mx-block__media" data-article-media><img src="@image" alt="" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" /></div>
            }
            <span class="mx-block__kicker">@string.Join(" · ", new[] { "Top story", Source(top), top.Undated ? null : Dates.Time(top.Date) }.Where(p => !string.IsNullOrEmpty(p)))</span>
            <h2 class="mx-block__title"><StoryLink Item="top" /></h2>
            <div class="mx-block__actions">
                <SaveButton Item="top" Title="@Title(top)" Source="@Source(top)" Summary="@FeedText.StripEmoji(FeedQuery.Excerpt(top.Description))" Labelled="true" />
                <ShareButton Url="@top.Url" Title="@Title(top)" Labelled="true" />
            </div>
        </article>
    }

    @{ var upNext = tonight.Where(i => i.StartsUtc is null || i.StartsUtc > nowUtc).Take(6).ToList(); }
    @if (liveGames.Count > 0 || upNext.Count > 0)
    {
        <div data-home-section="sports">
            <PhoneTimeline Heading="Today &amp; Tonight" Sub="@(tonight.Count > 0 ? $"{tonight.Count} {(tonight.Count == 1 ? "game" : "games")}" : null)"
                           Items="@upNext.Select(UpNext).ToList()" MoreText="All games and schedules" MoreHref="events">
                @if (liveGames.Count > 0)
                {
                    <h3 class="mx-live">Live now</h3>
                    <PhoneScoreTiles Games="liveGames" />
                }
                @if (liveGames.Count > 0 && upNext.Count > 0) { <h3 class="mx-subhead">Up next</h3> }
            </PhoneTimeline>
        </div>
    }

    @if (headlineStories.Count > 0)
    {
        <section class="mx-section" aria-labelledby="home-headlines-m" data-home-section="news">
            <div class="mx-head"><h2 id="home-headlines-m">Headlines</h2><a href="news/all">View all →</a></div>
            <ol class="mx-top">
                @foreach (var (item, i) in headlineStories.Take(3).Select((s, i) => (s, i)))
                {
                    <li class="@PhoneColors.ForCategory(item.CategoryName)">
                        <span class="mx-top__n" aria-hidden="true">@(i + 1)</span>
                        <span><span class="mx-top__title"><StoryLink Item="item" /></span><span class="mx-top__meta">@string.Join(" · ", new[] { Source(item), item.CategoryName }.Where(p => !string.IsNullOrEmpty(p)))</span></span>
                        <span class="mx-top__actions"><SaveButton Item="item" Title="@Title(item)" Source="@Source(item)" Summary="@FeedText.StripEmoji(FeedQuery.Excerpt(item.Description))" /><ShareButton Url="@item.Url" Title="@Title(item)" /></span>
                    </li>
                }
            </ol>
        </section>
    }

    <FoldGroup Name="home-more" Heading="More today" Foot="Choose what’s on your home page" FootHref="settings">
        @if (sportsStories.Count > 0)
        {
            <Fold Title="Sports" Section="sports-news" Color="mx-c-business" Open="true" AllHref="sports/news" AllText="All sports headlines"
                  Gist="@string.Join(" · ", sportsStories.Take(2).Select(Title))">
                @foreach (var item in sportsStories.Take(3)) { @StoryRow(item) }
            </Fold>
        }
        @if (boardGames.Count > 0)
        {
            var liveNow = boardGames.Where(g => g.Active).ToList();
            var shown = liveNow.Concat(boardGames.Where(g => g.Status == "upcoming")).Concat(boardGames.Where(g => !g.Active && g.Status != "upcoming")).Take(4);
            <Fold Title="Scoreboard" Section="scoreboard" Color="mx-c-us" AllHref="scoreboard" AllText="Every score"
                  Gist="@(liveNow.FirstOrDefault() is { } first ? $"{liveNow.Count} live now · {PhoneText.Matchup(first)} {PhoneText.Score(first)}" : $"{boardGames.Count} {(boardGames.Count == 1 ? "game" : "games")} today")">
                @foreach (var game in shown)
                {
                    <a class="mx-fold__row" href="scoreboard">
                        <span><b>@PhoneText.Matchup(game)</b><small>@ScoreboardPanel.CompetitionLabel(game.Sport, game.League) · @PhoneText.Clock(game, Dates)</small></span>
                        @if (PhoneText.Score(game) is { } score) { <span class="mx-fold__value">@score</span> }
                    </a>
                }
            </Fold>
        }
        @if (homeRankings.Teams.Count > 0)
        {
            var poll = homeRankings.Poll?.PollName ?? "Top 25";
            var big12 = homeRankings.Teams.FirstOrDefault(t => t.IsBig12 == true);
            <Fold Title="Top 25" Section="rankings" Color="mx-c-world" AllHref="rankings" AllText="All 25"
                  Gist="@($"{homeRankings.Teams[0].TeamName} No. {homeRankings.Teams[0].Rank}{(big12 is null || big12 == homeRankings.Teams[0] ? "" : $" · {big12.TeamName} No. {big12.Rank}")}")">
                @foreach (var team in homeRankings.Teams.Take(3))
                {
                    <a class="mx-fold__row" href="rankings">
                        <span><b>@team.TeamName</b><small>@string.Join(" · ", new[] { poll, team.Record, team.IsBig12 == true ? "Big 12" : null }.Where(p => !string.IsNullOrEmpty(p)))</small></span>
                        <span class="mx-fold__value">@team.Rank</span>
                    </a>
                }
            </Fold>
        }
        @if (entertainmentStories.Count > 0)
        {
            <Fold Title="Entertainment" Section="entertainment-news" Color="mx-c-tech" AllHref="entertainment/news" AllText="All entertainment headlines"
                  Gist="@string.Join(" · ", entertainmentStories.Take(2).Select(Title))">
                @foreach (var item in entertainmentStories.Take(3)) { @StoryRow(item) }
            </Fold>
        }
        @if (homeBoxOffice.Count > 0)
        {
            <Fold Title="Box office" Section="forecasts" Color="mx-c-tech" AllHref="box-office" AllText="Box office"
                  Gist="@($"{homeBoxOffice[0].Title}, {Money(homeBoxOffice[0].WeekendGross)}")">
                @foreach (var movie in homeBoxOffice.Take(3))
                {
                    <a class="mx-fold__row" href="box-office"><span><b>@movie.Title</b><small>No. @movie.Rank · weekend</small></span><span class="mx-fold__value">@Money(movie.WeekendGross)</span></a>
                }
            </Fold>
        }
        else if (homeForecasts.Movies.Where(m => m.Kind == BoxOfficeForecastQuery.Preview).ToList() is { Count: > 0 } previews)
        {
            <Fold Title="Box office" Section="forecasts" Color="mx-c-tech" AllHref="box-office" AllText="Forecasts"
                  Gist="@($"This weekend: {previews[0].Title}, {Money(previews[0].Low)}–{Money(previews[0].High)}")">
                @foreach (var movie in previews.Take(3))
                {
                    <a class="mx-fold__row" href="box-office"><span><b>@movie.Title</b><small>Forecast · this weekend</small></span><span class="mx-fold__value">@Money(movie.Low)–@Money(movie.High)</span></a>
                }
            </Fold>
        }
        @if (videos.Count > 0)
        {
            <Fold Title="Videos" Section="videos" Color="mx-c-local" AllHref="videos" AllText="YouTube"
                  Gist="@($"{videos.Count} new from {videos.Select(v => v.ChannelId).Distinct().Count()} channels")">
                @foreach (var video in videos.Take(3))
                {
                    <a class="mx-fold__row" href="@(FeedQuery.SafeHref(video.Url) ?? "videos")" target="_blank" rel="noopener noreferrer">
                        <span><b>@video.Title</b><small>@video.ChannelName</small></span>
                    </a>
                }
            </Fold>
        }
        @{
            var screens = episodes.Take(2).Select(e => (Title: e.SeriesTitle, Sub: string.Join(" · ", new[] { "Tonight", e.StartsUtc is { } t ? Dates.Time(t) : null, e.Platform }.Where(p => !string.IsNullOrEmpty(p))), Href: "tv"))
                .Concat((ShowTheatrical ? movies : []).Take(1).Select(m => (Title: m.Title, Sub: "Friday · In theaters", Href: "movies?type=theatrical")))
                .Concat(digitalMovies.Take(1).Select(m => (Title: m.Title, Sub: string.Join(" · ", new[] { m.Date?.ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture), "Digital" }.Where(p => !string.IsNullOrEmpty(p))), Href: "movies/digital")))
                .ToList();
        }
        @if (screens.Count > 0)
        {
            <Fold Title="Coming to screens" Section="tv" Color="mx-c-us" AllHref="tv" AllText="TV and releases"
                  Gist="@string.Join(" · ", screens.Take(2).Select(s => s.Title))">
                @foreach (var screen in screens)
                {
                    <a class="mx-fold__row" href="@screen.Href"><span><b>@screen.Title</b><small>@screen.Sub</small></span></a>
                }
            </Fold>
        }
        <Fold Title="Latest YouTube video" Section="opinion" Color="mx-c-local" AllHref="videos" AllText="All videos"
              Gist="@(latestVideo is { } v ? $"{v.ChannelName} · {v.Title}" : latestVideoFailed ? "Temporarily unavailable" : "Follow channels to see their latest video")">
            <HomeLatestVideo Item="@latestVideo" Failed="@latestVideoFailed" Embedded="true" />
        </Fold>

    </FoldGroup>
</div>

@code {
    // Masthead Live now line, away @ home: "Bruins 3 @ Hurricanes 1"; before the start "Kings @ Rangers"; "vs" at a
    // neutral site, where neither team is home.
    public static string LiveLine(ScoreboardGame game)
    {
        var scored = game.Active || game.AwayScore is not null;
        string Team(string name, decimal? score) => scored && score is { } s ? $"{name} {s:0}" : name;
        return Team(game.AwayName, game.AwayScore) + (game.NeutralSite == true ? " vs " : " @ ") + Team(game.HomeName, game.HomeScore);
    }

    [SupplyParameterFromQuery(Name = "rankingSourceId")] private string? RankingSourceId { get; set; }
    [SupplyParameterFromQuery(Name = "scoreboardShow")] private string? ScoreboardShow { get; set; }
    private RankingsPage homeRankings = new([], null, null, []);
    private F1Page homeF1 = F1Page.Empty;
    private string? homeF1Error;
    private bool FoldF1 => F1Query.HomeWeekendRace(homeF1, Dates, Dates.TodayAt(nowUtc)) is not null;
    // News used to live at "/", so an old bookmark like "/?category=3" is sent on to "/news/all" with its query intact.
    [SupplyParameterFromQuery(Name = "category")] private string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "after")] private string? After { get; set; }

    private bool ShowTheatrical => MoviesQuery.HomeTheatricalFriday(Dates.TodayAt(nowUtc)) is not null;
    private DateTime nowUtc;
    private IReadOnlyList<EventItem> todays = [];
    private IReadOnlyList<TonightItem> tonight = [];
    private IReadOnlyList<FeedItem> news = [];
    private HomeLeadSnapshot lead = new(null, 0, 60000);
    private IReadOnlyList<FeedItem> headlineStories = [];
    private IReadOnlyList<FeedItem> sportsStories = [];
    private IReadOnlyList<FeedItem> entertainmentStories = [];
    private VideoItem? latestVideo;
    private bool latestVideoFailed;
    private IReadOnlyList<VideoItem> videos = [];
    private IReadOnlyList<BoxOfficeMovie> homeBoxOffice = [];
    private bool homeBoxOfficeFailed;
    private BoxOfficeForecastSnapshot homeForecasts = new([], []);
    private IReadOnlyList<MovieReleaseItem> movies = [];
    private IReadOnlyList<MovieReleaseItem> digitalMovies = [];
    private DigitalReleasePage? digitalData;
    private IReadOnlyList<TvEpisodeItem> episodes = [];
    private IReadOnlyList<ScoreboardGame> liveGames = [];
    private IReadOnlyList<ScoreboardGame> upcomingGames = [];
    private LocalWeatherPage? weather;

    protected override async Task OnParametersSetAsync()
    {
        if (Category is not null || Q is not null || After is not null)
        {
            Nav.NavigateTo("news/all" + new Uri(Nav.Uri).Query, replace: true);
            return;
        }

        nowUtc = DateTime.UtcNow;
        await using var db = await Factory.CreateDbContextAsync();
        homeF1 = F1Page.Empty; homeF1Error = null;
        try { homeF1 = await F1Query.GetAsync(db, "schedule"); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read home F1 summary."); homeF1Error = "F1 data is temporarily unavailable. Please try again."; }
        try { homeRankings = await RankingsQuery.GetAsync(db, StandingsQuery.ParseSourceId(RankingSourceId), Log, Dates.TodayAt(nowUtc)); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read home rankings."); homeRankings = new([], null, null, [], "Rankings are temporarily unavailable."); }

        // The queries run one after another: one DbContext cannot run two at once.
        todays = await EventsQuery.GetOnDateAsync(db, Dates.TodayAt(nowUtc));
        try { lead = await HomeLeadQuery.GetAsync(db, nowUtc); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read home lead story."); lead = new(null, nowUtc.Ticks / TimeSpan.TicksPerHour, 60000, true); }
        news = await FeedQuery.GetHomeNewsAsync(db, HomeNewsCount, "headlines");
        headlineStories = news.Where(item => item.Id != lead.Article?.Id).Take(4).ToList();
        sportsStories = await FeedQuery.GetHomeNewsAsync(db, HomeShelfCount, "sports");
        entertainmentStories = await FeedQuery.GetHomeNewsAsync(db, HomeShelfCount, "entertainment");
        latestVideo = null; latestVideoFailed = false;
        try { latestVideo = (await VideosQuery.GetVideosAsync(db, Reader.Viewer, null, null, limit: 1)).Items.FirstOrDefault(); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read the latest followed YouTube video."); latestVideoFailed = true; }
        videos = await VideosQuery.GetHomeVideosAsync(db, Reader.Viewer);
        homeForecasts = new([], []);
        homeBoxOffice = []; homeBoxOfficeFailed = false;
        if (HomeBoxOfficeSchedule.ShowResults(Dates.TodayAt(nowUtc)))
        {
            try
            {
                var weekend = HomeBoxOfficeSchedule.ResultsWeekend(Dates.TodayAt(nowUtc));
                homeBoxOffice = await BoxOfficeChartQuery.GetAsync(db, weekend);
            }
            catch (Exception ex) when (DataFailures.IsReadFailure(ex))
            { Log.LogError(ex, "Could not read home weekend results."); homeBoxOfficeFailed = true; }
        }
        else
        {
        try { homeForecasts = await BoxOfficeForecastQuery.GetAsync(db, Dates.TodayAt(nowUtc)); }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read home weekend predictions."); }
        }
        movies = await MoviesQuery.GetFridayTheatricalAsync(db, Dates.TodayAt(nowUtc));
        digitalData = await DigitalReleasesQuery.GetAsync(db, Dates.TodayAt(nowUtc), null, take: 5);
        digitalMovies = digitalData.Items;
        episodes = await TvQuery.GetOnDateAsync(db, Reader.Viewer, Dates, Dates.TodayAt(nowUtc));
        todays = await HomeEventResults.WithoutFinalResultsAsync(db, todays);
        tonight = TodayTonight.Build(todays, Dates);

        // Masthead ear: what is live, otherwise what starts next. The scoreboard read reports failures itself.
        var board = await Scoreboard.ReadAsync(Dates.TodayAt(nowUtc), carryOver: true);
        boardGames = board.Games;
        liveGames = board.Games.Where(g => g.Active).Take(3).ToList();
        upcomingGames = board.Games.Where(g => g.Status == "upcoming").Take(3).ToList();

        // At-a-glance forecast (cached by LocalWeather). A slow or failed weather service only hides the band.
        weather = null;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            weather = await Weather.GetAsync(timeout.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or OperationCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        { Log.LogWarning(ex, "Home forecast unavailable."); }
    }

    private IReadOnlyList<ScoreboardGame> boardGames = [];

    private static string Title(FeedItem item) => FeedText.StripEmoji(item.Title) is { Length: > 0 } t ? t : item.Title;
    private static string Source(FeedItem item) => FeedText.SourceName(item.SourceLabel, item.SourceUrl);

    private RenderFragment StoryRow(FeedItem item) => __builder =>
    {
        <a class="mx-fold__row" href="@(FeedQuery.SafeHref(item.Url) ?? "news")" target="_blank" rel="noopener noreferrer">
            <span><b>@Title(item)</b><small>@string.Join(" · ", new[] { Source(item), item.CategoryName }.Where(p => !string.IsNullOrEmpty(p)))</small></span>
        </a>
    };

    private myNewspaper.Web.Components.Phone.TimelineItem UpNext(TonightItem item) => new(
        item.StartsUtc is { } starts ? Dates.Time(starts) : item.TimeLabel, PhoneText.Matchup(item), item.Kind, item.Tv,
        item.Url ?? "events", PhoneColors.ForSport(item.Kind), External: item.Url is not null);

    /// <summary>"This Afternoon" reads as "Today", "Thursday Night" as "Thu night", so four fit across a phone.</summary>
    private static string ShortPeriod(string name) => name switch
    {
        "This Afternoon" or "This Morning" or "Today" => "Today",
        _ when name.EndsWith(" Night", StringComparison.Ordinal) && name.Length > 9 => name[..3] + " night",
        "Monday" or "Tuesday" or "Wednesday" or "Thursday" or "Friday" or "Saturday" or "Sunday" => name[..3],
        _ => name,
    };

    /// <summary>"$19.5M", "$850K".</summary>
    private static string Money(long dollars) => dollars >= 1_000_000
        ? "$" + (dollars / 1_000_000m).ToString(dollars >= 100_000_000 ? "0" : "0.0", System.Globalization.CultureInfo.InvariantCulture) + "M"
        : "$" + (dollars / 1_000m).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "K";

    private const int HomeNewsCount = 15;
    private const int HomeShelfCount = 4;
}
