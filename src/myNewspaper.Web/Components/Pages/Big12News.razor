@using myNewspaper.Web.Components.Feed
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject ILogger<Big12News> Log

<h2>Big 12 News</h2>
<p class="updated">Conference-wide articles from official Big 12 feeds and independent reporting, across all sports.</p>
@if (error is not null)
{ <p class="empty" role="status">@error</p> }
else
{
    <div class="filters">
        @if (data.Sources.Count > 0)
        {
            <form class="catselect" method="get" action="college/news">
                <input type="hidden" name="sport" value="@CollegeHub.Resolve(Sport).Key" />
                @if (!string.IsNullOrWhiteSpace(Q)) { <input type="hidden" name="q" value="@Q" /> }
                <label class="sr-only" for="big12-news-source">Big 12 news source</label>
                <select id="big12-news-source" name="source" onchange="this.form.requestSubmit()">
                    <option value="">All sources</option>
                    @foreach (var source in data.Sources)
                    { <option value="@source.Id" selected="@(data.SourceId == source.Id)">@source.Name</option> }
                </select>
                <noscript><button type="submit" class="nf-btn nf-btn--secondary">Apply</button></noscript>
            </form>
        }
        <span class="count count--toolbar">@data.Feed.Total @(data.Feed.Total == 1 ? "article" : "articles")</span>
    </div>
    @if (data.Updated is { } updated)
    { <p class="updated">Big 12 news last updated <time datetime="@updated.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">@Dates.PublishedFull(updated)</time></p> }
    @if (data.Feed.Items.Count == 0)
    {
        <p class="empty">
            @if (data.SourceId != null || !string.IsNullOrWhiteSpace(Q) || After != null)
            { <span>No articles match. <a href="@CollegeHub.Href("news", CollegeHub.Resolve(Sport))">Clear filters</a></span> }
            else
            { <span>No Big 12 articles available yet. Please check back soon.</span> }
        </p>
    }
    else
    {
        @if (After != null) { <p><a href="@Href(null)">← Back to the newest articles</a></p> }
        <section class="feed" aria-label="Big 12 articles" data-last-day="@lastDay">
            <FeedArticles Items="data.Feed.Items" LeadFirst="@(After is null)" Total="@(After is null ? data.Feed.Total : null)" />
        </section>
        <div class="loadmore">
            @if (data.Feed.Next is { } next)
            { <a class="nf-btn nf-btn--secondary" data-load-more data-feed-view="big12-news" data-enhance-nav="false" href="@Href(next.ToToken())">Load more articles</a> }
            <span class="count" data-shown-total>Showing @data.Feed.Shown of @data.Feed.Total</span>
            <span class="sr-only" role="status" data-load-status></span>
        </div>
    }
}
@code {
    [Parameter] public string Sport { get; set; } = "football";
    [SupplyParameterFromQuery(Name = "source")] private string? SourceQuery { get; set; }
    [SupplyParameterFromQuery(Name = "after")] private string? AfterQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    private FeedCursor? After => FeedCursor.Parse(AfterQuery);
    private Big12NewsPage data = new(null, [], null, new([], 0, 0, null), null);
    private string? error;
    private string? lastDay;
    private string Href(string? after) => CollegeHub.Href("news", CollegeHub.Resolve(Sport)) + "&" + FeedQuery.QueryString(null, Q, after, data.SourceId).TrimStart('?');
    protected override async Task OnParametersSetAsync()
    {
        error = null;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            data = await Big12NewsQuery.GetAsync(db, int.TryParse(SourceQuery, out var source) && source > 0 ? source : null, Q, After);
            lastDay = data.Feed.Items.Count > 0 ? Dates.DayKey(data.Feed.Items[^1]) : null;
        }
        catch (Exception ex) when (DataFailures.IsReadFailure(ex))
        { Log.LogError(ex, "Could not read Big 12 news."); error = "Big 12 news is temporarily unavailable. Please try again."; }
    }
}
