@page "/box-office"
@page "/box-office/weekend-preview"
@page "/box-office/movie-forecasts"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject NavigationManager Navigation
@inject ILogger<BoxOffice> Log

<PageTitle>@Title · myNewspaper</PageTitle>
<PageHeading Title="Domestic box office" Eyebrow="RESULTS &amp; FORECASTS" Description="Reported weekend totals from The Numbers and upcoming predictions from Boxoffice Pro." />
<form class="catselect" method="get" action="box-office">
    <label class="sr-only" for="box-office-view">Box office section</label>
    <select id="box-office-view" name="view" onchange="this.form.requestSubmit()">
        <option value="results" selected="@(view == "results")">Weekend results — Top 10</option>
        <option value="weekend-preview" selected="@(view == "weekend-preview")">Upcoming weekend preview — Predictions</option>
        <option value="movie-forecasts" selected="@(view == "movie-forecasts")">Upcoming movie forecasts — Predictions</option>
    </select>
    <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
</form>
@if (view == "results")
{
    <h2>Weekend results — Top 10</h2>
    @if (failed)
    {
        <p class="empty" role="status">Box-office totals are temporarily unavailable. <a href="box-office">Try again</a></p>
    }
    else if (movies.Count == 0)
    {
        <p class="empty">No weekend box-office chart is available yet. <a href="box-office">Check again</a></p>
    }
    else
    {
        var friday = movies[0].WeekendStart;
        <h3 class="boxoffice-weekend">@BoxOfficeChartQuery.WeekendLabel(friday)</h3>
        @if (BoxOfficeChartQuery.IsStale(friday, Dates.Today))
        { <p class="standing-status" role="status">This chart may be out of date; showing the last available weekend.</p> }
        <ol class="boxoffice-chart" aria-label="Domestic weekend box-office top ten">
            @foreach (var movie in movies)
            {
                <li class="boxoffice-movie" @key="movie.Rank">
                    <span class="boxoffice-rank" aria-label="@($"Rank {movie.Rank}")">@movie.Rank</span>
                    <MoviePoster Url="@movie.PosterUrl" Title="@movie.Title" Class="boxoffice-poster" />
                    <div class="boxoffice-movie-body">
                        <h3>@if (movie.MovieUrl is { } url) { <a href="@url" target="_blank" rel="noopener noreferrer">@movie.Title</a> } else { @movie.Title }</h3>
                        <dl class="boxoffice-stats">
                            <div><dt>Weekend · @BoxOfficeChartQuery.StatusLabel(movie.ResultStatus)</dt><dd>@BoxOfficeChartQuery.Money(movie.WeekendGross)</dd></div>
                            <div><dt>Total domestic</dt><dd>@BoxOfficeChartQuery.Money(movie.TotalDomesticGross)</dd></div>
                            <div><dt>Weekly change</dt><dd>@BoxOfficeChartQuery.Change(movie.WeeklyChangePercent)</dd></div>
                        </dl>
                        <BoxOfficeResultEvidence Movie="movie" />
                    </div>
                </li>
            }
        </ol>
        <p class="updated">Source: @if (movies[0].SourceUrl is { } source) { <a href="@source" target="_blank" rel="noopener noreferrer">The Numbers</a> } else { <span>The Numbers</span> } · Last checked @Dates.PublishedFull(movies.Min(m => m.FetchedAt))</p>
        <p class="updated">Final means provider-reported actuals; totals may still be revised. — means weekly change is unavailable or the movie is new.</p>
    }

}
else
{
    <BoxOfficeForecastSection Kind="@ForecastKind" Rows="@(forecasts.Movies.Where(m => m.Kind == ForecastKind).ToList())"
        Source="@(forecasts.Sources.SingleOrDefault(s => s.Kind == ForecastKind))" UtcNow="@utcNow" />
}

@code {
    [SupplyParameterFromQuery(Name = "view")] private string? SelectedView { get; set; }
    private string view = "results";
    private string ForecastKind => view == "weekend-preview" ? BoxOfficeForecastQuery.Preview : BoxOfficeForecastQuery.LongRange;
    private string Title => view switch { "weekend-preview" => "Weekend predictions", "movie-forecasts" => "Movie forecasts", _ => "Box Office" };

    private IReadOnlyList<BoxOfficeMovie> movies = [];
    private bool failed;
    private BoxOfficeForecastSnapshot forecasts = new([], []);
    private readonly DateTime utcNow = DateTime.UtcNow;
    protected override async Task OnParametersSetAsync()
    {
        if (SelectedView is "results" or "weekend-preview" or "movie-forecasts")
        {
            Navigation.NavigateTo(SelectedView == "results" ? "box-office" : "box-office/" + SelectedView, forceLoad: true);
            return;
        }
        view = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Split('/').Last() switch
        {
            "weekend-preview" => "weekend-preview", "movie-forecasts" => "movie-forecasts", _ => "results"
        };
        if (view == "results")
        {
            try
            {
                await using var db = await Factory.CreateDbContextAsync();
                movies = await BoxOfficeChartQuery.GetAsync(db);
            }
            catch (Exception ex) when (DataFailures.IsReadFailure(ex))
            { Log.LogError(ex, "Box-office chart read failed."); failed = true; }
        }
        else
        {
            try
            {
                await using var db = await Factory.CreateDbContextAsync();
                forecasts = await BoxOfficeForecastQuery.GetAsync(db, Dates.TodayAt(utcNow));
            }
            catch (Exception ex) when (DataFailures.IsReadFailure(ex))
            { Log.LogError(ex, "Box-office forecast read failed."); }
        }
    }
}
