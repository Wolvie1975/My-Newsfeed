@page "/box-office"
@page "/box-office/weekend-preview"
@page "/box-office/movie-forecasts"
@layout PublicLayout
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject NavigationManager Navigation
@inject ILogger<BoxOffice> Log

<PageTitle>@Title · myNewspaper</PageTitle>
<PageHeading Section="entertainment" Title="Box office" Eyebrow="Results &amp; forecasts" Description="" />

@* Box office as in the approved concept: three views as pills (a segmented control on phones); results are an agate
   table on desktop and two-line rows on phones. *@
<nav class="sec-pills bo-views" aria-label="Box office section">
    <a href="box-office" aria-current="@(view == "results" ? "page" : null)"><span class="bo-views__long">Weekend results · Top 10</span><span class="bo-views__short">Results</span></a>
    <a href="box-office/weekend-preview" aria-current="@(view == "weekend-preview" ? "page" : null)"><span class="bo-views__long">Next weekend · predictions</span><span class="bo-views__short">Next weekend</span></a>
    <a href="box-office/movie-forecasts" aria-current="@(view == "movie-forecasts" ? "page" : null)"><span class="bo-views__long">Upcoming movie forecasts</span><span class="bo-views__short">Forecasts</span></a>
</nav>
@if (view == "results")
{
    <section class="bo-results" aria-labelledby="bo-title">
    @if (failed)
    {
        <h2 id="bo-title" class="sr-only">Weekend results</h2>
        <p class="empty" role="status">Box-office totals are temporarily unavailable. <a href="box-office">Try again</a></p>
    }
    else if (movies.Count == 0)
    {
        <h2 id="bo-title" class="sr-only">Weekend results</h2>
        <p class="empty">No weekend box-office chart is available yet. <a href="box-office">Check again</a></p>
    }
    else
    {
        var friday = movies[0].WeekendStart;
        var reported = movies.Any(m => m.ResultStatus == "final");
        <div class="bo-head">
            <h2 id="bo-title">@BoxOfficeChartQuery.WeekendLabel(friday) <span class="bo-head__scope">· domestic</span></h2>
            <span class="mv-updated">@(reported ? "Reported" : "Estimates") from @if (movies[0].SourceUrl is { } source) { <a href="@source" target="_blank" rel="noopener noreferrer">The Numbers</a> } else { <span>The Numbers</span> }@(predictions.Count > 0 ? " · predictions from Boxoffice Pro" : "") · checked @Dates.Time(movies.Min(m => m.FetchedAt))</span>
        </div>
        @if (BoxOfficeChartQuery.IsStale(friday, Dates.Today))
        { <p class="standing-status" role="status">This chart may be out of date; showing the last available weekend.</p> }
        <table class="bo-table" aria-label="Domestic weekend box-office top ten">
            <thead>
                <tr><th scope="col">#</th><th scope="col">Film</th><th scope="col">Weekend</th><th scope="col">Predicted</th><th scope="col">Change</th><th scope="col">Total domestic</th></tr>
            </thead>
            <tbody>
                @foreach (var movie in movies)
                {
                    var isNew = movie.WeeklyChangePercent is null && movie.TotalDomesticGross == movie.WeekendGross;
                    var change = BoxOfficeChartQuery.Change(movie.WeeklyChangePercent);
                    predictions.TryGetValue(BoxOfficeForecastQuery.TitleKey(movie.Title), out var predicted);
                    <tr @key="movie.Rank">
                        <td class="bo-table__rank" aria-label="@($"Rank {movie.Rank}")">@movie.Rank</td>
                        <th scope="row" class="bo-table__film">
                            @if (movie.MovieUrl is { } url) { <a href="@url" target="_blank" rel="noopener noreferrer">@movie.Title</a> } else { @movie.Title }
                            @if (isNew) { <span class="bo-new">New</span> }
                            <span class="bo-table__total-inline">Total @BoxOfficeChartQuery.Compact(movie.TotalDomesticGross)</span>
                        </th>
                        <td class="bo-table__weekend" title="@BoxOfficeChartQuery.Money(movie.WeekendGross)">@BoxOfficeChartQuery.Compact(movie.WeekendGross)<span class="sr-only"> · @BoxOfficeChartQuery.StatusLabel(movie.ResultStatus)</span></td>
                        <td class="bo-table__predicted">@(predicted is null ? "—" : BoxOfficeForecastQuery.Range(predicted.Low, predicted.High))</td>
                        <td class="bo-table__change @(change.StartsWith('+') ? "bo-up" : change.StartsWith('-') ? "bo-down" : null)">@change</td>
                        <td class="bo-table__total" title="@BoxOfficeChartQuery.Money(movie.TotalDomesticGross)">@BoxOfficeChartQuery.Compact(movie.TotalDomesticGross)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="ef-note">Weekend figures are estimates until finals are reported; totals may still be revised. — means the change is unavailable or the film is new.</p>
    }
    </section>
}
else
{
    <BoxOfficeForecastSection Kind="@ForecastKind" Rows="@(forecasts.Movies.Where(m => m.Kind == ForecastKind).ToList())"
        Source="@(forecasts.Sources.SingleOrDefault(s => s.Kind == ForecastKind))" UtcNow="@utcNow" />
}

@code {
    [SupplyParameterFromQuery(Name = "view")] private string? SelectedView { get; set; }
    private string view = "results";
    private string ForecastKind => view == "weekend-preview" ? BoxOfficeForecastQuery.Preview : BoxOfficeForecastQuery.LongRange;
    private string Title => view switch { "weekend-preview" => "Weekend predictions", "movie-forecasts" => "Movie forecasts", _ => "Box Office" };

    private IReadOnlyList<BoxOfficeMovie> movies = [];
    private IReadOnlyDictionary<string, BoxOfficeForecast> predictions = new Dictionary<string, BoxOfficeForecast>();
    private bool failed;
    private BoxOfficeForecastSnapshot forecasts = new([], []);
    private readonly DateTime utcNow = DateTime.UtcNow;
    protected override async Task OnParametersSetAsync()
    {
        if (SelectedView is "results" or "weekend-preview" or "movie-forecasts")
        {
            Navigation.NavigateTo(SelectedView == "results" ? "box-office" : "box-office/" + SelectedView, forceLoad: true);
            return;
        }
        view = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Split('/').Last() switch
        {
            "weekend-preview" => "weekend-preview", "movie-forecasts" => "movie-forecasts", _ => "results"
        };
        if (view == "results")
        {
            try
            {
                await using var db = await Factory.CreateDbContextAsync();
                movies = await BoxOfficeChartQuery.GetAsync(db);
                if (movies.Count > 0) predictions = await BoxOfficeForecastQuery.PredictionsAsync(db, movies[0].WeekendStart);
            }
            catch (Exception ex) when (DataFailures.IsReadFailure(ex))
            { Log.LogError(ex, "Box-office chart read failed."); failed = true; }
        }
        else
        {
            try
            {
                await using var db = await Factory.CreateDbContextAsync();
                forecasts = await BoxOfficeForecastQuery.GetAsync(db, Dates.TodayAt(utcNow));
            }
            catch (Exception ex) when (DataFailures.IsReadFailure(ex))
            { Log.LogError(ex, "Box-office forecast read failed."); }
        }
    }
}
