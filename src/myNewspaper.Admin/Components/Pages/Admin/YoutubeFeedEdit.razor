@page "/admin/youtube-feeds/new"
@page "/admin/youtube-feeds/{Id:int}/edit"
@rendermode InteractiveServer
@using System.Globalization
@inject IDbContextFactory<WebScraperContext> Factory
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add YouTube feed" : "Edit YouTube feed")</PageTitle>

<AdminContent>
    <AdminPageHeader Eyebrow="Videos" Title="@(IsNew ? "Add YouTube feed" : "Edit YouTube feed")">
        <Crumbs><a href="admin/youtube-feeds">YouTube feeds</a><span aria-hidden="true">/</span>@(IsNew ? "New" : "Edit")</Crumbs>
    </AdminPageHeader>

@if (notFound)
{
    <div class="alert alert-warning">That feed no longer exists. <a href="admin/youtube-feeds">Back to feeds</a></div>
}
else if (form is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" class="adm-card" style="max-width: 46rem;">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="mb-3">
            <label for="channel-id" class="form-label">Channel ID</label>
            <InputText id="channel-id" class="form-control" @bind-Value="form.ChannelId" placeholder="UC…" disabled="@channelLocked" />
            @if (channelLocked)
            {
                <div class="form-text">The channel ID can't change while videos are linked to this feed, because each video stores it too.</div>
            }
            else
            {
                <div class="form-text">The channel's ID (starts with UC), from its YouTube page or feed address.</div>
            }
        </div>

        <div class="mb-3">
            <label for="channel-name" class="form-label">Channel name (optional)</label>
            <InputText id="channel-name" class="form-control" @bind-Value="form.ChannelName" />
        </div>

        <div class="mb-3">
            <label for="feed-url" class="form-label">Feed address</label>
            <InputText id="feed-url" class="form-control" @bind-Value="form.Url" placeholder="Leave blank to use the standard address for the channel ID" />
            <div class="form-text">The channel's Atom feed, the address the scraper's <code>--youtube-feed</code> option takes.</div>
        </div>

        <div class="mb-3">
            <label for="feed-category" class="form-label">Category</label>
            <InputSelect id="feed-category" class="form-select" @bind-Value="form.CategoryId">
                <option value="">No category (shown under Other)</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.CategoryName</option>
                }
            </InputSelect>
            <div class="form-text">The YouTube page's category tabs. Categories themselves are added by the scraper.</div>
        </div>

        <div class="adm-toggle-row mb-3">
            <span>
                <span id="household-pick-l" class="adm-label d-block">Suggest to everyone</span>
                <span id="household-pick-d" class="adm-help d-block">A household pick: anyone who doesn’t follow it sees it as a one-tap suggestion in their Settings.</span>
            </span>
            <AdminSwitch Checked="form.IsHouseholdPick" LabelledBy="household-pick-l" DescribedBy="household-pick-d" OnChange="v => form.IsHouseholdPick = v" />
        </div>

        @if (!IsNew && existing is not null)
        {
            <dl class="row small text-muted">
                <dt class="col-sm-3">Added</dt>
                <dd class="col-sm-9">@Dates.Stamp(existing.DateAdded)</dd>
                <dt class="col-sm-3">Videos</dt>
                <dd class="col-sm-9"><a href="admin/youtube-videos?feedId=@existing.Id">@videoCount</a></dd>
            </dl>
        }

        <p class="small text-muted">The scraper picks up new and changed rows on its next run.</p>

        <button type="submit" class="btn btn-primary me-2" disabled="@saving">Save</button>
        <a class="btn btn-secondary" href="admin/youtube-feeds">Cancel</a>
    </EditForm>
}

</AdminContent>

@code {
    [Parameter] public int? Id { get; set; }

    public sealed class FeedForm
    {
        [Required, StringLength(40)]
        [RegularExpression("^[A-Za-z0-9_-]+$", ErrorMessage = "A channel ID has only letters, numbers, hyphens and underscores.")]
        public string ChannelId { get; set; } = "";

        [StringLength(200)]
        public string? ChannelName { get; set; }

        [StringLength(2048)]
        public string? Url { get; set; }

        // Bound to a <select>, so it is text; "" means no category.
        public string CategoryId { get; set; } = "";

        public bool IsHouseholdPick { get; set; }
    }

    private IReadOnlyList<YoutubeCategory> categories = [];

    private FeedForm? form;
    private YoutubeVideoFeed? existing;
    private int videoCount;
    private bool notFound;
    private bool saving;
    private bool channelLocked;
    private string? error;

    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        categories = await db.YoutubeCategories.AsNoTracking().OrderBy(c => c.CategoryName).ToListAsync();
        if (IsNew)
        {
            form = new FeedForm();
            return;
        }

        existing = await db.YoutubeVideoFeeds.AsNoTracking().FirstOrDefaultAsync(f => f.Id == Id);
        if (existing is null)
        {
            notFound = true;
            return;
        }

        videoCount = await db.YouTubeVideos.CountAsync(v => v.YoutubeVideoFeedId == Id);
        channelLocked = videoCount > 0;
        form = new FeedForm
        {
            ChannelId = existing.ChannelId, ChannelName = existing.ChannelName, Url = existing.Url,
            CategoryId = existing.YoutubeCategoryId?.ToString(CultureInfo.InvariantCulture) ?? "",
            IsHouseholdPick = existing.IsHouseholdPick,
        };
    }

    private async Task SaveAsync()
    {
        if (form is null)
        {
            return;
        }

        error = null;
        var channelId = form.ChannelId.Trim();
        var name = string.IsNullOrWhiteSpace(form.ChannelName) ? null : form.ChannelName.Trim();
        var url = string.IsNullOrWhiteSpace(form.Url) ? AdminData.YoutubeFeedUrl(channelId) : form.Url.Trim();
        // Only a category that still exists; anything else saves as no category.
        int? categoryId = int.TryParse(form.CategoryId, NumberStyles.None, CultureInfo.InvariantCulture, out var picked)
            && categories.Any(c => c.Id == picked) ? picked : null;

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            error = "Enter a full feed address that starts with http:// or https://.";
            return;
        }

        saving = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            if (IsNew)
            {
                db.YoutubeVideoFeeds.Add(new YoutubeVideoFeed
                {
                    ChannelId = channelId, ChannelName = name, Url = url, YoutubeCategoryId = categoryId, IsHouseholdPick = form.IsHouseholdPick,
                });
            }
            else
            {
                var feed = await db.YoutubeVideoFeeds.FindAsync(Id);
                if (feed is null)
                {
                    notFound = true;
                    return;
                }

                if (!channelLocked)
                {
                    feed.ChannelId = channelId;
                }

                feed.ChannelName = name;
                feed.Url = url;
                feed.YoutubeCategoryId = categoryId;
                feed.IsHouseholdPick = form.IsHouseholdPick;
            }

            await db.SaveChangesAsync();
            // A new feed is a household channel: turn it on for everyone now rather than at the next 15-minute pass.
            await myNewspaper.Web.Profiles.HouseholdChannels.RunOnceAsync(db);
            Nav.NavigateTo("admin/youtube-feeds");
        }
        catch (DbUpdateException ex) when (AdminData.IsUniqueViolation(ex))
        {
            error = "A feed for that channel already exists.";
        }
        finally
        {
            saving = false;
        }
    }
}
