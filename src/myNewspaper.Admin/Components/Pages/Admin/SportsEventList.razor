@page "/admin/sports-events"
@rendermode InteractiveServer
@inject IDbContextFactory<WebScraperContext> Factory
@inherits DataComponentBase

<PageTitle>Events</PageTitle>

<AdminContent>
    <AdminPageHeader Eyebrow="Sports" Title="Events" />

@if (message is not null)
{
    <div class="alert alert-@messageKind" role="alert">@message</div>
}

<form class="row g-2 mb-3" @onsubmit="SearchAsync">
    <div class="col-md-2">
        <label for="type" class="visually-hidden">Type</label>
        <select id="type" class="form-select" @bind="typeFilter" @bind:after="ApplyFilterAsync">
            <option value="">All types</option>
            <option value="none">No type</option>
            @foreach (var type in types)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="sport" class="visually-hidden">Sport</label>
        <select id="sport" class="form-select" @bind="sportFilter" @bind:after="ApplyFilterAsync">
            <option value="">All sports</option>
            @foreach (var sport in sports)
            {
                <option value="@sport">@sport</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="when" class="visually-hidden">When</label>
        <select id="when" class="form-select" @bind="whenFilter" @bind:after="ApplyFilterAsync">
            <option value="">All dates</option>
            <option value="upcoming">Upcoming</option>
            <option value="past">Past</option>
        </select>
    </div>
    <div class="col-md-4">
        <label for="search" class="visually-hidden">Search</label>
        <input id="search" class="form-control" placeholder="Search game, opponent or location" @bind="searchInput" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
        @if (HasFilters)
        {
            <button type="button" class="btn btn-outline-secondary ms-1" @onclick="ClearAsync">Clear</button>
        }
    </div>
</form>

@if (pendingDelete is { } target)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-2">Delete the event <strong>@target.Title</strong>? The scraper adds it back on its next run if the feed still lists it.</p>
        <button class="btn btn-danger btn-sm me-2" @onclick="ConfirmDeleteAsync">Delete event</button>
        <button class="btn btn-secondary btn-sm" @onclick="() => pendingDelete = null">Cancel</button>
    </div>
}

@if (rows is null)
{
    <p><em>Loading…</em></p>
}
else if (rows.Count == 0)
{
    <p>No events match.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th class="text-nowrap"><button class="btn btn-link p-0 fw-bold text-decoration-none" @onclick='() => SortByAsync("date")'>Date@(SortMark("date"))</button></th>
                    <th><button class="btn btn-link p-0 fw-bold text-decoration-none" @onclick='() => SortByAsync("sport")'>Sport@(SortMark("sport"))</button></th>
                    <th>Game</th>
                    <th><button class="btn btn-link p-0 fw-bold text-decoration-none" @onclick='() => SortByAsync("opponent")'>Opponent@(SortMark("opponent"))</button></th>
                    <th>Home / away</th>
                    <th>Location</th>
                    <th>TV</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="text-nowrap">
                            @row.EventDate.ToString("yyyy-MM-dd")
                            <div class="small text-muted">@TimeText(row)</div>
                        </td>
                        <td>@(row.Sport ?? "—")</td>
                        <td>
                            @if (FeedQuery.SafeHref(row.Url) is { } href)
                            {
                                <a href="@href" target="_blank" rel="noopener noreferrer">@row.Title</a>
                            }
                            else
                            {
                                @row.Title
                            }
                        </td>
                        <td>@(row.Opponent ?? "—")</td>
                        <td>@(row.IsAway is bool away ? (away ? "Away" : "Home") : "—")</td>
                        <td>@(row.Location ?? "—")</td>
                        <td>@(row.Tv ?? "—")</td>
                        <td>
                            @if (row.TypeId is int typeId)
                            {
                                <a href="admin/sports-event-types/@typeId/edit">@row.TypeName</a>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No type</span>
                            }
                        </td>
                        <td class="text-nowrap text-end">
                            <a class="btn btn-outline-primary btn-sm" href="admin/sports-events/@row.Id/edit">Edit</a>
                            <button class="btn btn-outline-danger btn-sm" disabled="@row.AttributionLocked" title="@(row.AttributionLocked ? "Managed by the scraper. Disable its feed instead." : "Delete event")" @onclick="() => StartDelete(row)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <AdminPager Total="total" PageIndex="pageIndex" PageSize="PageSize" Noun="events" PageChanged="GoToAsync" />
}

</AdminContent>

@code {
    private const int PageSize = 25;

    // Query values arrive as text and are parsed leniently: a hand-edited "?typeId=abc" must not throw.
    [SupplyParameterFromQuery(Name = "typeId")] private string? TypeIdText { get; set; }

    private IReadOnlyList<EventTypeOption> types = [];
    private IReadOnlyList<string> sports = [];
    private IReadOnlyList<AdminEventRow>? rows;
    private AdminEventRow? pendingDelete;
    private string? message;
    private string messageKind = "success";

    // typeFilter is bound to the <select>: "" = all types, "none" = events with no type, otherwise a type ID.
    private string? typeFilter;
    private string? sportFilter;

    // "upcoming" and "past" are relative to today's date in the display zone (Central); past games are kept as history.
    private string? whenFilter;
    private string searchInput = "";
    private string search = "";
    private string sortColumn = "date";
    private bool sortDescending;
    private int pageIndex;
    private int total;

    private bool HasFilters => !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(typeFilter)
        || !string.IsNullOrEmpty(sportFilter) || !string.IsNullOrEmpty(whenFilter);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Factory.CreateDbContextAsync(Ct);
        types = await AdminQuery.EventTypeOptionsAsync(db, ct: Ct);
        sports = await AdminQuery.EventSportsAsync(db, Ct);

        if (TypeIdText == "none")
        {
            typeFilter = "none";
        }
        else if (int.TryParse(TypeIdText, out var id) && types.Any(t => t.Id == id))
        {
            typeFilter = id.ToString();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await Factory.CreateDbContextAsync(Ct);
        var list = await AdminQuery.EventsAsync(db, typeFilter, sportFilter, whenFilter, Dates.Today, search, sortColumn, sortDescending,
            pageIndex, PageSize, Ct);
        (rows, total, pageIndex) = (list.Rows, list.Total, list.PageIndex);
    }

    // The feed's time is the host school's, stored as UTC. It is shown in the site's zone with its offset, not as the venue's clock.
    private string TimeText(AdminEventRow row) =>
        row.TimeTbd ? "Time TBD" : row.StartsAtUtc is DateTime start ? Dates.TimeWithOffset(start) : "—";

    private async Task SearchAsync()
    {
        search = searchInput.Trim();
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        searchInput = search = "";
        typeFilter = sportFilter = whenFilter = null;
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task SortByAsync(string column)
    {
        sortDescending = sortColumn == column && !sortDescending;
        sortColumn = column;
        pageIndex = 0;
        await LoadAsync();
    }

    private string SortMark(string column) => sortColumn != column ? "" : sortDescending ? " ▼" : " ▲";

    private async Task GoToAsync(int index)
    {
        pageIndex = Math.Max(0, index);
        await LoadAsync();
    }

    private void StartDelete(AdminEventRow row)
    {
        message = null;
        pendingDelete = row;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is not { } target)
        {
            return;
        }

        await using var db = await Factory.CreateDbContextAsync(CancellationToken.None);
        try
        {
            var deleted = await AdminStore.DeleteSportsEventAsync(db, target.Id, CancellationToken.None);
            messageKind = deleted ? "success" : "warning";
            message = deleted ? $"Deleted “{target.Title}”." : "That event was already deleted.";
        }
        catch (InvalidOperationException ex) { messageKind = "warning"; message = ex.Message; }
        catch (Exception ex) when (AdminStore.IsForeignKeyViolation(ex))
        { messageKind = "warning"; message = "This event gained shared source references. Disable its feed instead of deleting it."; }
        pendingDelete = null;
        await LoadAsync();
    }
}
