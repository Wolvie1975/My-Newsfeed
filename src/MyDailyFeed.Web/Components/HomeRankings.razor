@inject FeedDates Dates

<section data-home-section="rankings" class="d-card d-rankings" aria-labelledby="h-home-rankings">
    <div class="d-card__head">
        <h2 class="d-card__title" id="h-home-rankings">Top 25</h2>
        <a class="d-more" href="@(Data.Selected is { } selected ? $"rankings?sourceId={selected.Id}" : "rankings")">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="d-rankings__body">
        @if (Data.Sources.Count > 0)
        {
            <form class="catselect" method="get" action="">
                <label for="home-ranking-source">Sport and poll</label>
                <select id="home-ranking-source" name="rankingSourceId" onchange="this.form.requestSubmit()">
                    @foreach (var source in Data.Sources)
                    { <option value="@source.Id" selected="@(source.Id == Data.Selected?.Id)">@source.DisplayName</option> }
                </select>
                <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
            </form>
        }
        @if (Data.AvailabilityError is { } error)
        { <p class="empty" role="status">@error <a href="">Try again</a></p> }
        else if (Data.Selected is null)
        { <p class="empty">No ranking sources are available.</p> }
        else if (Data.Poll is not { } poll || !RankedTeams.Any())
        { <p class="empty">Rankings not available yet for @Data.Selected.DisplayName.</p> }
        else
        {
            <p class="updated">@poll.PollName · @poll.SeasonLabel · @(RankingsQuery.OldPoll(poll, DateTime.UtcNow) ? "Latest available poll dated" : "Poll dated") @Dates.Published(poll.PublishedAtUtc)</p>
            @if (RankingsQuery.Freshness(Data.Selected, DateTime.UtcNow) is { } warning)
            { <p class="updated" role="status">@warning</p> }
            <div class="standings-scroll d-rankings__table" role="region" aria-label="Top 25 teams" tabindex="0">
                <table class="standings-table rankings-table">
                    <caption>@Data.Selected.Sport · @poll.PollName</caption>
                    <thead><tr><th scope="col">Rank</th><th scope="col" class="standing-team">School</th><th scope="col">Record</th><th scope="col">Conference</th><th scope="col">Previous rank</th></tr></thead>
                    <tbody>
                    @foreach (var team in RankedTeams)
                    {
                        <tr class="@(team.IsBig12 == true ? "ranking-big12" : null)">
                            <td>@team.Rank</td>
                            <th scope="row" class="standing-team"><span class="standing-team-name">
                                <span>@team.TeamName</span>
                            </span></th>
                            <td>@(team.Record ?? "—")</td>
                            <td>@(team.IsBig12 == true ? "Big 12" : Conferences.TryGetValue(team.TeamId, out var conference) ? conference : "—")</td>
                            <td>@RankingsQuery.Previous(team)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="updated">Data via ESPN · Big 12 members highlighted</p>
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyDictionary<string, string> Conferences { get; set; } = new Dictionary<string, string>();
    [Parameter] public RankingsPage Data { get; set; } = new([], null, null, []);
    private IEnumerable<MyDailyFeed.Web.Data.Models.SportsRankingTeam> RankedTeams =>
        Data.Teams.Where(t => t.Rank is >= 1 and <= 25).OrderBy(t => t.Rank).ThenBy(t => t.TeamName);
}
