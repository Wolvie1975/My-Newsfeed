@using MyDailyFeed.Web.Data
@using MyDailyFeed.Web.Scores
@inject FeedDates Dates

@* One finished game as a table row, away team first as on the events page. Phones stack it as a card (competition,
   away, score, home, venue); tablets put the teams either side of the score; from 1180px it is a real table row.
   The winner is ESPN's own call, so a shoot-out or a forfeit is shown the way ESPN reports it. *@

@{
    var competition = TeamRecords.Competition(Item.Sport, Item.League);
    var score = Item.AwayScore is { } a && Item.HomeScore is { } h ? $"{a} – {h}" : "–";
    var shootout = Item.AwayShootout is { } sa && Item.HomeShootout is { } sh ? $"Shootout {sa} – {sh}" : null;
    var status = string.Join(" · ", new[] { Item.StatusText, shootout }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var (city, venue) = EventsText.SplitLocation(Item.Venue);
}

<tr class="result" role="row" data-sports-teams="@SportsTeamPreferences.Keys(Item.HomeName, Item.AwayName)">
    <td class="td-comp" role="cell"><abbr title="@Item.LeagueName">@Item.LeagueTag</abbr></td>
    <td class="td-raway @(Item.WinnerSide == "away" ? "is-winner" : "")" role="cell"><TeamCell Record="@Records.Find(competition.Provider, competition.Sport, Item.AwayName, Item.AwayTeamId)" Name="@Item.AwayName" LogoUrl="@EspnClient.SmallLogo(Item.AwayLogoUrl)" Label="Away" /></td>
    <td class="td-score" role="cell">
        <span class="score__time">@Dates.EventTime(Item.StartsAtUtc)</span>
        <span class="score">@score</span>
        <MyDailyFeed.Web.Components.BoxScores.BoxScoreLink Identity="@(new BoxIdentity(Item.Sport ?? "",Item.League ?? "",Item.EventId))" Labels="BoxLabels" Context="@($"{Item.AwayName} at {Item.HomeName}")" />
        @if (status.Length > 0)
        {
            <span class="score__status">@status</span>
        }
    </td>
    <td class="td-rhome @(Item.WinnerSide == "home" ? "is-winner" : "")" role="cell"><TeamCell Record="@Records.Find(competition.Provider, competition.Sport, Item.HomeName, Item.HomeTeamId)" Name="@Item.HomeName" LogoUrl="@EspnClient.SmallLogo(Item.HomeLogoUrl)" Label="Home" /></td>
    <td class="td-rloc @(city is null ? "td-rloc--none" : "")" role="cell">
        @if (city is not null)
        {
            <div class="loc">
                <span>@city</span>
                @if (venue is not null)
                {
                    <span class="loc__venue">@venue</span>
                }
            </div>
        }
    </td>
</tr>

@code {
    [Parameter] public IReadOnlyDictionary<string,string> BoxLabels {get;set;} = new Dictionary<string,string>();
    [Parameter] public TeamRecords Records { get; set; } = TeamRecords.Empty;
    [Parameter, EditorRequired] public ResultItem Item { get; set; } = default!;
}
