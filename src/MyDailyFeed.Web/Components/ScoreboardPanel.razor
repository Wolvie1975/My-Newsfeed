@inject ScoreboardRepository Repository
@inject BoxScoresRepository BoxScores
@inject FeedDates Dates

<div data-scoreboard data-scoreboard-compact="@Compact.ToString().ToLowerInvariant()">
    <p class="updated scoreboard-note">Scores update approximately every 10 minutes. <span>Checks every five minutes while visible.</span></p>
    @if (!Compact)
    {
        <nav class="tv-week" aria-label="Scoreboard dates">
            @if (selectedDay > today.AddDays(-3)) { <a class="nf-btn nf-btn--secondary" href="@Href(selectedDay.AddDays(-1))">← Previous day</a> }
            <strong>@FeedDates.LongDate(selectedDay) · CT</strong>
            @if (selectedDay < today.AddDays(7)) { <a class="nf-btn nf-btn--secondary" href="@Href(selectedDay.AddDays(1))">Next day →</a> }
            @if (selectedDay != today) { <a href="@Href(today)">Today</a> }
        </nav>
        <form method="get" action="scoreboard" class="catselect scoreboard-filter">
            <input type="hidden" name="day" value="@selectedDay.ToString("yyyy-MM-dd")" />
            <label for="scoreboard-competition">Competition</label>
            <select id="scoreboard-competition" name="competition">
                <option value="">All enabled competitions</option>
                @foreach (var c in snapshot.Coverage.DistinctBy(c => c.Key).OrderBy(c => c.Sport).ThenBy(c => c.League)) {
                    <option value="@c.Key" selected="@(Competition == c.Key)">@CompetitionLabel(c.Sport, c.League)</option>
                }
            </select>
            <button class="nf-btn nf-btn--secondary" type="submit">Apply</button>
        </form>
    }
    <p class="scoreboard-read-status updated" role="status">@(snapshot.Available ? "" : "Scores are temporarily unavailable. Please retry.")</p>
    @if (snapshot.Available)
    {
        @if (snapshot.Coverage.Where(c => string.IsNullOrEmpty(Competition) || c.Key == Competition).Any(c => c.Availability is "error" or "partial" || c.LastSuccessAt == null)) {
            <p class="updated">Some coverage is delayed or unavailable. Showing the latest stored scores.</p>
        }
        @if (snapshot.Games.Count == 0) {
            <p class="empty">@(snapshot.Coverage.Count == 0 ? "No scoreboard coverage is currently enabled." : "No games are currently stored for this day and selection. Coverage may still be updating.")</p>
        }
        <div class="scoreboard-games">
        @foreach (var game in visibleGames)
        {
            <article class="scoreboard-game" data-scoreboard-key="@game.Key">
                <header class="scoreboard-game-heading">
                    <span class="scoreboard-competition">@CompetitionLabel(game.Sport, game.League)</span>
                    <strong class="scoreboard-status @(game.Status == "live" ? "scoreboard-live" : "")">@(game.Status == "live" ? "Live" : game.Status == "final" ? "Final" : game.Label)</strong>
                </header>
                <div class="scoreboard-matchup">
                    <div class="scoreboard-team @(game.Status == "final" && game.Completed && game.WinnerSide == "away" ? "scoreboard-winner" : "")">
                        <MyDailyFeed.Web.Components.Events.TeamCell Name="@game.AwayName" LogoUrl="@game.AwayLogoUrl" />
                        <strong class="scoreboard-score">@ScoreboardGame.Score(game.AwayScore)</strong>
                        @if (game.AwayPreference is {} away) { <button type="button" class="scoreboard-favorite" data-scoreboard-team="@away" aria-label="@($"Highlight {game.AwayName} in this competition")" aria-pressed="false" hidden>☆</button> }
                    </div>
                    <div class="scoreboard-team @(game.Status == "final" && game.Completed && game.WinnerSide == "home" ? "scoreboard-winner" : "")">
                        <MyDailyFeed.Web.Components.Events.TeamCell Name="@game.HomeName" LogoUrl="@game.HomeLogoUrl" />
                        <strong class="scoreboard-score">@ScoreboardGame.Score(game.HomeScore)</strong>
                        @if (game.HomePreference is {} home) { <button type="button" class="scoreboard-favorite" data-scoreboard-team="@home" aria-label="@($"Highlight {game.HomeName} in this competition")" aria-pressed="false" hidden>☆</button> }
                    </div>
                </div>
                <div class="scoreboard-context">
                    @if (game.Status == "upcoming" || game.Status == "postponed" && game.WasRescheduled) {
                        <p>@(game.TimeTbd || game.StartsAtUtc == null ? "Start time TBD" : Dates.EventTime(game.StartsAtUtc.Value)) @(game.WasRescheduled ? "· Rescheduled" : "")</p>
                    }
                    else if (game.Status == "live" || game.Status == "final" && game.Label != "Final") {
                        <p>@game.Label @if (game.Status == "live") { <span class="scoreboard-sampled">· sampled</span> }</p>
                        @if (game.Status == "live" && game.Sport is not ("baseball" or "volleyball") && !string.IsNullOrWhiteSpace(game.DisplayClock) && !game.Label.Contains(game.DisplayClock, StringComparison.OrdinalIgnoreCase)) {
                            <p>@game.DisplayClock @(game.Period is {} period ? $"· Period {period}" : "") <span class="scoreboard-sampled">· sampled</span></p>
                        }
                    }
                    @if (game.ScoreboardDate < today && game.Active) { <p>Continuing from @FeedDates.LongDate(game.ScoreboardDate)</p> }
                    @if (game.HomeShootout != null || game.AwayShootout != null) { <p>Shootout · Away @(game.AwayShootout?.ToString() ?? "—") – Home @(game.HomeShootout?.ToString() ?? "—")</p> }
                </div>
                @if (!Compact && (game.Details != null || game.Venue != null || game.NeutralSite == true || game.Broadcasts != null)) {
                    <details class="scoreboard-info">
                        <summary>Game info</summary>
                        @if (game.Details is {} details) { <p>@details</p> }
                        @if (game.Venue != null || game.NeutralSite == true) { <p>@game.Venue @(game.NeutralSite == true ? "· Neutral site" : "")</p> }
                        @if (game.Broadcasts != null) { <p>@game.Broadcasts</p> }
                    </details>
                }
                <footer class="scoreboard-footer">
                    <p class="scoreboard-updated @(game.Stale(DateTime.UtcNow) ? "scoreboard-warning" : "")">
                        @(game.Stale(DateTime.UtcNow) ? "Scores may be outdated — last updated" : "Updated")
                        <time datetime="@DateTime.SpecifyKind(game.LastObservedAtUtc, DateTimeKind.Utc).ToString("O")" title="@Dates.PublishedFull(game.LastObservedAtUtc)">@Dates.Time(game.LastObservedAtUtc) @Dates.ZoneLabel</time>
                    </p>
                    @if (game.RequestAvailability is "error" or "partial") { <p class="scoreboard-warning">Latest collection is @(game.RequestAvailability == "partial" ? "incomplete" : "unavailable"); showing the latest stored sample.</p> }
                    <div class="scoreboard-actions">
                        @if (FeedQuery.SafeHref(game.SourceUrl) is {} url) { <a href="@url" target="_blank" rel="noopener noreferrer">Game details ↗</a> }
                        <MyDailyFeed.Web.Components.BoxScores.BoxScoreLink Identity="@(new BoxIdentity(game.Sport, game.League, game.EventId))" Labels="boxLabels" Context="@(game.AwayName + " at " + game.HomeName)" />
                    </div>
                </footer>
            </article>
        }
        </div>
        @if (Compact && snapshot.Games.Count > visibleGames.Count) { <p class="updated">Showing @visibleGames.Count of @snapshot.Games.Count games. <a href="scoreboard">See all games →</a></p> }
    }
    @if (!Compact) { <p class="updated scoreboard-note">Sampled clocks stay fixed between updates. Coverage excludes F1 and unsupported leagues.</p> }
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter, SupplyParameterFromQuery(Name="day")] public string? Day { get; set; }
    [Parameter, SupplyParameterFromQuery(Name="competition")] public string? Competition { get; set; }
    private readonly TimeZoneInfo central = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");
    private DateOnly today, selectedDay;
    private ScoreboardSnapshot snapshot = new([], [], true);
    private IReadOnlyList<ScoreboardGame> visibleGames = [];
    private IReadOnlyDictionary<string,string> boxLabels = new Dictionary<string,string>();
    private string Href(DateOnly day) => $"scoreboard?day={day:yyyy-MM-dd}" + (string.IsNullOrEmpty(Competition) ? "" : "&competition=" + Uri.EscapeDataString(Competition));
    public static string CompetitionLabel(string sport, string league) => league switch {
        "nfl" => "NFL", "mlb" => "MLB", "nhl" => "NHL", "wnba" => "WNBA", "usa.1" => "MLS", "usa.nwsl" => "NWSL", "eng.1" => "Premier League", "eng.2" => "EFL Championship",
        "college-football" => "College football", "mens-college-basketball" => "Men’s college basketball", "womens-college-basketball" => "Women’s college basketball", "usa.ncaa.w.1" => "Women’s college soccer", "womens-college-volleyball" => "Women’s college volleyball", _ => sport + " · " + league
    };
    protected override async Task OnParametersSetAsync() {
        today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, central));
        selectedDay = !Compact && DateOnly.TryParseExact(Day, "yyyy-MM-dd", out var day) && day >= today.AddDays(-3) && day <= today.AddDays(7) ? day : today;
        snapshot = await Repository.ReadAsync(selectedDay, selectedDay == today, Compact ? null : Competition);
        visibleGames = Compact ? snapshot.Games.Take(6).ToList() : snapshot.Games;
        boxLabels = await BoxScores.AvailableAsync(visibleGames.Where(g => g.Provider == "espn" && g.HasBoxScore).Select(g => new BoxIdentity(g.Sport, g.League, g.EventId)));
    }
}
