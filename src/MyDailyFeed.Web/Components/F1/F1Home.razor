@inject FeedDates Dates

<section data-home-section="@(Embedded ? null : "f1")" data-home-f1 class="@(Embedded ? "d-f1 d-f1--embedded" : "d-card d-f1")" aria-labelledby="h-f1">
    <div class="d-card__head">@if (Embedded) { <h3 class="d-card__title" id="h-f1">F1 · Race weekend</h3> } else { <h2 class="d-card__title" id="h-f1">F1</h2> }<a href="f1">Full schedule</a></div>
    <div class="d-f1__body">
        @if (error is not null)
        { <p class="d-empty" role="status">@error</p> }
        else if (data.Source?.Enabled != true)
        { <p class="d-empty">F1 data is not enabled.</p> }
        else
        {
            <div>
                @if (nextRace is { } race)
                {
                    <p class="movie-kind">Next Grand Prix · Season @race.Season · Round @race.Round</p>
                    <h3><a href="f1">@race.RaceName</a></h3>
                    <p>@race.CircuitName · @string.Join(", ", new[] { race.Locality, race.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                    <p><SessionTime Session="@(new F1Session("Grand Prix", race.RaceDate, F1Query.StartsUtc(race.RaceDate, race.RaceTimeUtc)))" /></p>
                    @if (nextSession is { Name: not "Grand Prix" } session)
                    { <p class="updated">Next session: @session.Name · <SessionTime Session="session" /></p> }
                    @if (F1Query.StartsUtc(race.RaceDate, race.RaceTimeUtc) is { } start && start < NowUtc && !data.Choices.Any(c => c.Round == race.Round && c.SessionType == "Race"))
                    { <p class="updated">Results pending/unavailable.</p> }
                }
                else
                { <p class="d-empty">@(data.Races.Count == 0 ? "No F1 calendar available yet." : "No upcoming races in the collected season. View the full schedule for past weekends.")</p> }
            </div>
            <div>
                @if (latest is { } result && latestRace is { } previous)
                {
                    <p class="movie-kind">Latest published result · Round @result.Round</p>
                    <h3><a href="@($"f1/results?race={result.Value}")">@previous.RaceName · @(result.SessionType == "Race" ? "Grand Prix" : "Sprint")</a></h3>
                }
                else
                { <p class="updated">No race or sprint classifications published yet.</p> }
                <nav class="tv-week" aria-label="F1 home links"><a href="f1">Schedule</a><a href="f1/results">Results</a><a href="f1/standings">Standings</a><a href="f1/news">News</a></nav>
            </div>
            <div class="d-f1__freshness">
                @if (data.FetchedAt is { } updated) { <p class="updated">F1 snapshot updated @Dates.PublishedFull(updated)</p> }
                @if (F1Query.Freshness(data, NowUtc) is { } warning) { <p class="updated" role="status">@warning</p> }
                <p class="updated">Data: <a href="https://github.com/jolpica/jolpica-f1" target="_blank" rel="noopener noreferrer">Jolpica F1</a> · Periodically collected published data.</p>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public F1Page Data { get; set; } = F1Page.Empty;
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public DateTime NowUtc { get; set; }
    private F1Page data => Data;
    private string? error => Error;
    private MyDailyFeed.Web.Data.Models.F1Race? nextRace;
    private MyDailyFeed.Web.Data.Models.F1Race? latestRace;
    private F1ResultChoice? latest;
    private F1Session? nextSession;
    protected override void OnParametersSet()
    {
        var today = Dates.TodayAt(NowUtc);
        nextRace = F1Query.HomeWeekendRace(data, Dates, today) ?? data.Races.FirstOrDefault(r => F1Query.Upcoming(r, Dates, today)
            && !data.Choices.Any(c => c.Round == r.Round && c.SessionType == "Race"));
        nextSession = nextRace is null ? null : F1Query.Sessions(nextRace)
            .FirstOrDefault(s => s.StartsUtc is { } start ? start >= NowUtc : s.Date >= today);
        latest = F1Query.Select(data.Choices, null);
        latestRace = data.Races.FirstOrDefault(r => r.Round == latest?.Round);
    }
}
