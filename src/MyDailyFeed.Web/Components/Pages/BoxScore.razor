@page "/box-score/{Sport}/{League}/{EventId}"
@layout PublicLayout
@inject BoxScoresRepository Repository
<PageTitle>Game statistics · MyDailyFeed</PageTitle>
<PageHeading Title="Game statistics" Eyebrow="SPORTS RESULTS" Description="Available collected team and player statistics." />
<p><a href="scoreboard">← Scoreboard</a></p>
<MyDailyFeed.Web.Components.BoxScores.BoxScoreContent Detail="detail" />
@code {
    [Parameter] public string Sport {get;set;}="";
    [Parameter] public string League {get;set;}="";
    [Parameter] public string EventId {get;set;}="";
    [CascadingParameter] private HttpContext? Http {get;set;}
    private BoxDetail? detail;
    protected override async Task OnParametersSetAsync() {
        detail=await Repository.GetAsync(new(Sport,League,EventId));
        if(detail==null && Http!=null && !Http.Response.HasStarted)Http.Response.StatusCode=404;
    }
}
