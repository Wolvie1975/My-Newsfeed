@page "/"
@layout PublicLayout
@inject MyDailyFeed.Web.Scores.LeaguePhases RecordPhases
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates
@inject NavigationManager Nav

<PageTitle>Home · MyDailyFeed</PageTitle>

@* Static (non-interactive) page: a small slice of News, Sports Events and Videos, each with a "View all" link.
   Today, the greeting and the date are all decided on the server in the display zone (Central), so every visitor sees
   the same day and nothing here needs JavaScript. *@

<div class="d-hello">
    <h1>@Dates.Greeting(nowUtc)</h1>
    <p>@Dates.TodayLabel(nowUtc)</p>
</div>

<nav class="personal-links" aria-label="Your daily links"><a href="local">Kansas City</a><a href="watch">Where to watch</a></nav>
<p class="empty" data-home-empty hidden>All home sections are hidden. <button type="button" data-home-reset class="nf-btn nf-btn--secondary">Restore default homepage</button></p>
<p class="updated" data-personal-status role="status"></p>
<div class="d-grid" data-home-grid>

    <section data-home-section="sports" class="d-card d-today" aria-labelledby="h-tonight">
        <div class="d-card__head"><h2 class="d-card__title" id="h-tonight">Today &amp; Tonight</h2><a href="events">All games</a></div>
        @if (tonight.Count == 0) { <p class="d-empty">No remaining games today. View All games for upcoming fixtures.</p> }
        <p class="d-empty" data-home-teams-empty hidden>No remaining games match your selected teams. <a href="events">Browse all games</a>.</p>
        <ul class="d-list">
            @foreach (var item in tonight)
            {
                <li class="d-game" data-home-team-item data-sports-teams="@SportsTeamPreferences.Keys(item.SchoolName, item.OpponentName)">
                    <div class="d-game__body">
                        <h3 class="d-game__match">
                        @if (item.Url is not null)
                        { <a href="@item.Url" target="_blank" rel="noopener noreferrer"><TonightMatchup Item="item" Records="records" /></a> }
                        else { <TonightMatchup Item="item" Records="records" /> }
                    </h3><p class="d-game__meta">@item.Kind</p></div>
                        <div class="d-game__details">
                            <div><span class="d-game__label">Time</span><span class="d-game__time">@item.TimeLabel</span></div>
                            @if (item.Location is not null)
                            {
                                var (city, venue) = EventsText.SplitLocation(item.Location);
                                <div><span class="d-game__label">Location</span><span>@city</span>
                                    @if (venue is not null) { <span>@venue</span> }
                                </div>
                            }
                            @if (item.Tv is not null)
                            { <div><span class="d-game__label">TV / Streaming</span><span>@item.Tv</span></div> }
                            @if (item.StreamUrl is not null)
                            { <a href="@item.StreamUrl" target="_blank" rel="noopener noreferrer">Watch stream</a> }
                        </div>
                </li>
            }
        </ul>
    </section>

    <section data-home-section="tv" class="d-card d-episodes" aria-labelledby="h-tv">
        <div class="d-card__head">
            <h2 class="d-card__title" id="h-tv">Today’s episodes <span class="d-card__count">@episodes.Count @(episodes.Count == 1 ? "episode" : "episodes")</span></h2>
            <a class="d-more" href="tv">View calendar <span aria-hidden="true">→</span></a>
        </div>
        @if (episodes.Count == 0)
        {
            <p class="d-empty">No new episodes from followed series today.</p>
        }
        else
        {
            <ul class="d-list d-tv__list">
                @foreach (var group in episodes.GroupBy(e => e.ShowId))
                {
                    var series = group.First();
                    <li class="d-tv__show">
                        <div class="tv-poster" aria-hidden="true">
                            @if (EventsText.LogoUrl(series.Poster) is { } poster)
                            { <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" /> }
                        </div>
                        <div class="d-tv__body">
                            <p class="movie-kind">@(series.Platform ?? "Network not announced")</p>
                            <h3 class="d-vid__title">@series.SeriesTitle</h3>
                            <ul class="d-tv__episodes">
                                @foreach (var episode in group)
                                {
                                    var label = episode.Special ? "Special" : episode.Season is { } season && episode.Number is { } number ? $"S{season:00} E{number:00}" : "Episode";
                                    <li>
                                        @if (FeedQuery.SafeHref(episode.Url) is { } link)
                                        { <a href="@link" target="_blank" rel="noopener noreferrer">@label · @(episode.Title ?? "Title to be announced")</a> }
                                        else { <span>@label · @episode.Title</span> }
                                        <span class="movie-meta">@(episode.StartsUtc is { } time ? Dates.TimeWithOffset(time) : "Time not confirmed")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            </ul>
        }
        <p class="d-tv__credit">Episode data and images: <a href="https://www.tvmaze.com" target="_blank" rel="noopener noreferrer">TVmaze</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. Date-only releases retain their original date; confirmed times use @Dates.Zone.Id.</p>
    </section>

    <section data-home-section="news" class="d-card d-news" aria-labelledby="h-news">
        <div class="d-card__head">
            <h2 class="d-card__title" id="h-news">Latest news <span class="d-card__count">Up to 10 sources · rotates hourly</span></h2>
            <a class="d-more" href="news">View all <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a>
        </div>
        @if (news.Count == 0)
        {
            <p class="d-empty">No articles yet. Check back soon.</p>
        }
        else
        {
            <ul class="d-list">
                @foreach (var item in news)
                {
                    var href = FeedQuery.SafeHref(item.Url);
                    var title = FeedText.StripEmoji(item.Title);
                    var summary = FeedText.StripEmoji(FeedQuery.Excerpt(item.Description));
                    var image = FeedQuery.SafeHref(item.ImageUrl);
                    var sourceName = FeedText.SourceName(item.SourceLabel, item.SourceUrl);
                    <li class="d-story" data-news-url="@href" data-news-source="@sourceName">
                        @* The title is the real link; the picture repeats it for mouse and touch only. *@
                        <a class="d-thumb" href="@href" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                            <span class="d-thumb__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m21 16-5-5-8 9"></path></svg></span>
                            @if (image is not null)
                            {
                                <img src="@image" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
                            }
                        </a>
                        <div class="d-story__body">
                            <div class="d-story__top">
                                <span class="d-src">@sourceName</span>
                                <span class="d-story__tools">
                                    @if (item.CategoryName is not null)
                                    {
                                        <a class="d-cat" href="news?category=@item.CategoryId">@item.CategoryName</a>
                                    }
                                    <MyDailyFeed.Web.Components.Feed.ShareButton Url="@item.Url" Title="@(title.Length > 0 ? title : item.Title)" />
                                    <MyDailyFeed.Web.Components.Feed.SaveButton Item="item" Title="@(title.Length > 0 ? title : item.Title)" Source="@sourceName" Summary="@summary" />
                                </span>
                            </div>
                            <h3 class="d-story__title">
                                @if (href is not null)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer">@(title.Length > 0 ? title : item.Title)</a>
                                }
                                else
                                {
                                    @(title.Length > 0 ? title : item.Title)
                                }
                            </h3>
                            @if (!item.Undated)
                            {
                                <p class="d-story__date"><time datetime="@item.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")" title="@Dates.PublishedFull(item.Date)">Published @Dates.Published(item.Date) · @Dates.Time(item.Date)</time></p>
                            }
                            @if (!string.IsNullOrEmpty(summary))
                            {
                                <p class="d-story__sum">@summary</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section data-home-section="videos" class="d-card d-vids" aria-labelledby="h-vids">
        <div class="d-card__head">
            <h2 class="d-card__title" id="h-vids">Latest videos <span class="d-card__count">Up to 10 channels · rotates hourly</span></h2>
            <a class="d-more" href="videos">View all <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a>
        </div>
        @if (videos.Count == 0)
        {
            <p class="d-empty">No videos yet. Check back soon.</p>
        }
        else
        {
            <ul class="d-list">
                @foreach (var video in videos)
                {
                    var href = FeedQuery.SafeHref(video.Url);
                    var picture = VideosText.Thumbnail(video.ThumbnailUrl, video.VideoId);
                    var views = VideosText.Views(video.ViewCount);
                    <li class="d-vid">
                        <a class="d-thumb" href="@href" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                            <span class="d-thumb__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m21 16-5-5-8 9"></path></svg></span>
                            @if (picture is not null)
                            {
                                <img src="@picture" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
                            }
                            <span class="play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z"></path></svg></span>
                        </a>
                        <div class="d-vid__body">
                            <p class="d-vid__chan"><span class="d-mark" aria-hidden="true">@VideosText.Initial(video.ChannelName)</span><span class="d-vid__name">@video.ChannelName</span></p>
                            <h3 class="d-vid__title">
                                @if (href is not null)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer">@video.Title</a>
                                }
                                else
                                {
                                    @video.Title
                                }
                            </h3>

                            <p class="d-vid__meta">
                                <time datetime="@video.PublishedAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")" title="@Dates.PublishedFull(video.PublishedAt)">@Dates.Published(video.PublishedAt)</time>
                                @if (views is not null)
                                {
                                    <span aria-hidden="true">·</span>
                                    <span>@views</span>
                                }
                                <span class="video-actions">
                                    <MyDailyFeed.Web.Components.Feed.ShareButton Url="@video.Url" Title="@video.Title" Kind="video" />
                                    <MyDailyFeed.Web.Components.Feed.VideoSaveButton Item="video" />
                                </span>
                            </p>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <MyDailyFeed.Web.Components.F1.F1Home />

    <section data-home-section="movies" class="d-card d-movies" aria-labelledby="h-movies h-digital">
        <div class="d-card__head">
            <h2 class="d-card__title" id="h-movies">Friday theater releases</h2>
            <a class="d-more" href="movies">View all <span aria-hidden="true">→</span></a>
        </div>
        @if (movies.Count == 0)
        {
            <p class="d-empty">No upcoming Friday theater releases announced yet.</p>
        }
        else
        {
            <ul class="d-list" tabindex="0" aria-label="Upcoming Friday theater releases">
                @foreach (var movie in movies)
                {
                    var href = FeedQuery.SafeHref(movie.SourceUrl);
                    <li class="d-movie">
                        <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="d-movie__poster" />
                        <div class="d-movie__body">
                            @if (movie.Date is { } date)
                            {
                                <p class="d-movie__date"><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>@(movie.DateStatus == "estimated" ? " · Estimated" : "")</p>
                            }
                            <h3 class="d-vid__title">
                                @if (href is not null)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer">@movie.Title</a>
                                }
                                else
                                {
                                    @movie.Title
                                }
                            </h3>
                            <p class="d-vid__meta">@string.Join(" · ", new[] { movie.Certification, movie.Runtime is { } runtime ? $"{runtime} min" : null, movie.ReRelease ? "Re-release" : null }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                            <MovieCommerceAction Item="movie" />
                        </div>
                    </li>
                }
            </ul>
        }
        <div class="d-card__head">
            <h2 class="d-card__title" id="h-digital">Upcoming Digital / VOD
                @if (digitalData?.Selected is { } source)
                {
                    <span class="d-card__count">@source.Name · From today onward</span>
                }
            </h2>
            <a class="d-more" href="movies/digital">View all <span aria-hidden="true">→</span></a>
        </div>
        @if (digitalData?.Selected is { } digitalSource)
        {
            @if (!string.IsNullOrWhiteSpace(digitalSource.LastError)) { <p class="updated">Latest collection failed; showing previously collected releases when available.</p> }
        }
        @if (digitalMovies.Count == 0)
        {
            <p class="d-empty">No confirmed digital releases from the selected source from today onward.</p>
        }
        else
        {
            <ul class="d-list" tabindex="0" aria-label="Upcoming Digital / VOD">
                @foreach (var movie in digitalMovies)
                {
                    var href = FeedQuery.SafeHref(movie.SourceUrl);
                    <li class="d-movie">
                        <MoviePoster Url="@movie.Poster" Title="@movie.Title" Class="d-movie__poster" />
                        <div class="d-movie__body">
                            @if (movie.Date is { } date)
                            {
                                <p class="d-movie__date"><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>@(movie.DateStatus == "estimated" ? " · Estimated" : "")</p>
                            }
                            <h3 class="d-vid__title">
                                @if (href is not null)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer">@movie.Title</a>
                                }
                                else
                                {
                                    @movie.Title
                                }
                            </h3>
                            <p class="d-vid__meta">VOD / Digital · @movie.Source</p>
                            <p class="d-vid__meta">@string.Join(" · ", new[] { movie.Certification, movie.Runtime is { } runtime ? $"{runtime} min" : null, movie.ReRelease ? "Re-release" : null }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                            <MovieCommerceAction Item="movie" />
                        </div>
                    </li>
                }
            </ul>
        }
    </section>


</div>

@code {
    private TeamRecords records = TeamRecords.Empty;
    // News used to live at "/", so an old bookmark like "/?category=3" is sent on to "/news" with its query intact.
    [SupplyParameterFromQuery(Name = "category")] private string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "after")] private string? After { get; set; }

    private DateTime nowUtc;
    private IReadOnlyList<EventItem> todays = [];
    private IReadOnlyList<TonightItem> tonight = [];
    private IReadOnlyList<FeedItem> news = [];
    private IReadOnlyList<VideoItem> videos = [];
    private IReadOnlyList<MovieReleaseItem> movies = [];
    private IReadOnlyList<MovieReleaseItem> digitalMovies = [];
    private DigitalReleasePage? digitalData;
    private IReadOnlyList<TvEpisodeItem> episodes = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Category is not null || Q is not null || After is not null)
        {
            Nav.NavigateTo("news" + new Uri(Nav.Uri).Query, replace: true);
            return;
        }

        nowUtc = DateTime.UtcNow;
        await using var db = await Factory.CreateDbContextAsync();
        records = await TeamRecords.LoadAsync(db, Dates.Today, RecordPhases);

        // The queries run one after another: one DbContext cannot run two at once.
        todays = await EventsQuery.GetOnDateAsync(db, Dates.TodayAt(nowUtc));
        news = await FeedQuery.GetHomeNewsAsync(db, HomeNewsCount);
        videos = await VideosQuery.GetHomeVideosAsync(db);
        movies = await MoviesQuery.GetFridayTheatricalAsync(db, Dates.TodayAt(nowUtc));
        digitalData = await DigitalReleasesQuery.GetAsync(db, Dates.TodayAt(nowUtc), null, take: 5);
        digitalMovies = digitalData.Items;
        episodes = await TvQuery.GetOnDateAsync(db, Dates, Dates.TodayAt(nowUtc));
        todays = await HomeEventResults.WithoutFinalResultsAsync(db, todays);
        tonight = TodayTonight.Build(todays, Dates);
    }

    private const int HomeNewsCount = 10;
}
