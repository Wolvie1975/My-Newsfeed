@page "/watch/{Kind}/{Id:int}"
@layout PublicLayout
@using MyDailyFeed.Web.Watching
@inject WatchCatalog Catalog
@inject FeedDates Dates
<PageTitle>Where to watch · MyDailyFeed</PageTitle>
<p><a href="watch">← Where to watch</a></p>
<div data-watch-content>
@if(detail is null){<h2>Title unavailable</h2><p role="status">We couldn’t load this title’s viewing options. Please try again shortly.</p>}
else{
<h2>@detail.Title.Name</h2>
<div class="watch-detail">
@if(detail.Title.Poster is {} poster){<img src="@poster" alt="" width="180" height="270" />}
<div><p>@(Kind=="movie"?"Movie":"TV show") · @detail.Title.Year · United States</p><p>@detail.Title.Overview</p>
@if(detail.Offers.Count==0){<p>No US viewing options are currently listed in this data. This does not confirm the title is unavailable everywhere.</p>}
@foreach(var offer in detail.Offers){<section class="watch-offer"><h3>@offer.Category</h3><ul>@foreach(var provider in offer.Providers){<li>@provider</li>}</ul></section>}
@if(detail.Link is {} link){<p><a class="nf-btn nf-btn--primary" href="@link" target="_blank" rel="noopener noreferrer">Open viewing options ↗</a></p>}
<TrackSeriesLink Title="detail.Title" />
<p class="updated">Availability checked @Dates.PublishedFull(detail.Checked). @if(Kind=="tv"){<span>TV listings are for the series; season availability can vary.</span>}</p>
</div></div>
<WatchCredits />
}
</div>
@code {
    [Parameter]public string Kind {get;set;}="";
    [Parameter]public int Id {get;set;}
    [CascadingParameter]private HttpContext? Http {get;set;}
    private WatchAvailability? detail;
    protected override async Task OnParametersSetAsync(){detail=await Catalog.Detail(Kind,Id);if(detail is null&&Http is not null&&!Http.Response.HasStarted)Http.Response.StatusCode=WatchCatalog.Kind(Kind)&&Id>0?503:404;}
}
