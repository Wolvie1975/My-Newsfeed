@page "/saved"
@layout PublicLayout

<PageTitle>Saved · MyDailyFeed</PageTitle>

@* public.js loads the shared server list and safely builds the saved article cards. *@

<PageHeading Title="Saved articles" Eyebrow="YOUR READING LIST" Description="One shared reading list across your devices. Anyone with access to this site shares this list." />

<p class="count" data-saved-status aria-live="polite">Connecting to your shared Saved list…</p>

<section class="feed" aria-label="Saved articles" data-saved-list></section>

<section class="empty saved-empty" data-saved-empty hidden><h2 data-saved-empty-title></h2><p data-saved-empty-description></p><a class="nf-btn nf-btn--primary" href="news" data-saved-empty-action>Browse news</a></section>

<noscript><p class="empty">Saved articles need JavaScript turned on.</p></noscript>
