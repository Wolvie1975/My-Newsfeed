@page "/events"
@layout PublicLayout
@inject MyDailyFeed.Web.Scores.LeaguePhases RecordPhases
@using MyDailyFeed.Web.Components.Events
@inject IDbContextFactory<WebScraperContext> Factory
@inject FeedDates Dates

<PageTitle>Sports Events · MyDailyFeed</PageTitle>

@* Static (non-interactive) page. Filters are plain links and a GET form, so every view has a shareable URL and works
   without JavaScript. Games are grouped by EventDate, the stored calendar date (Central for ESPN fixtures), which is never converted. *@

<PageHeading Title="Sports Events" Eyebrow="YOUR SPORTS CALENDAR" Description="Games from today through the next three days, with start times, venues, and broadcasts." />
<MyDailyFeed.Web.Components.Events.TeamRecordsNote />

<form class="catselect" method="get" action="events">
    <label class="sr-only" for="schedule">League or sport</label>
    <select id="schedule" name="schedule" onchange="this.form.requestSubmit()">
        <option value="">All schedules</option>
        @foreach (var choice in choices)
        { <option value="@choice.Value" selected="@(selectedChoice?.Value == choice.Value)">@choice.Name</option> }
    </select>
    <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
</form>
<SoccerLeagueLinks Provider="@selectedProvider" />
@if (selectedProvider == "espn-championship")
{
    <form class="ranking-detail-toggle" method="get" action="events">
        @if (selectedChoice is not null) { <input type="hidden" name="schedule" value="@selectedChoice.Value" /> }
        else { <input type="hidden" name="school" value="@School" />
            @if (!string.IsNullOrWhiteSpace(Sport)) { <input type="hidden" name="sport" value="@Sport" /> } }
        <label><input type="checkbox" name="team" value="352" checked="@(Team == 352)" onchange="this.form.requestSubmit()" /> Wrexham AFC only</label>
        <noscript><button class="nf-btn nf-btn--secondary" type="submit">Apply</button></noscript>
    </form>
}
<div class="filters">
    @if (listing is not null)
    {
        <p class="count count--toolbar" aria-live="polite">@listing.Total @(listing.Total == 1 ? "event" : "events")</p>
    }
</div>

@if (listing is not null)
{
    <p class="count count--inline">@listing.Total @(listing.Total == 1 ? "event" : "events")</p>
}

@if (lastUpdated is { } updated)
{
    <p class="updated">
        Schedule last updated
        <time datetime="@updated.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">@Dates.PublishedFull(updated)</time>
    </p>
}

@if (listing is null || listing.Items.Count == 0)
{
    <p class="empty">
        @if (!string.IsNullOrWhiteSpace(Sport) || School is not null || selectedChoice is not null)
        {
            <span>No events match in the next three days. <a href="events">Clear filters</a></span>
        }
        else
        {
            <span>No games scheduled from today through the next three days. Check back soon.</span>
        }
    </p>
}
else
{
    @* Column headings, shown once above every day (from 1180px). Each day's table keeps its own visually hidden
       headings for screen readers. *@
    <div class="games-head" aria-hidden="true">
        <span>Sport</span><span>Team / Away</span><span>Team / Home</span><span>Time</span><span>Location</span><span>Links</span>
    </div>

    <div class="groups">
        @foreach (var day in listing.Items.GroupBy(e => e.EventDate))
        {
            var key = day.Key.ToString("yyyy-MM-dd");
            <section class="group" aria-labelledby="day-@key">
                <h2 class="group__bar" id="day-@key"><time datetime="@key">@FeedDates.LongDate(day.Key)</time></h2>
                @{ var leagueIndex = 0; }
                @foreach (var league in GameGroups.Schedule(day))
                {
                    var leagueId = $"day-{key}-league-{leagueIndex++}";
                    <h3 class="league-heading" id="@leagueId">@league.Name</h3>
                <table class="games" role="table" aria-labelledby="@leagueId">
                    <thead role="rowgroup">
                        <tr role="row">
                            <th role="columnheader" scope="col">Sport</th>
                            <th role="columnheader" scope="col">Team / Away</th>
                            <th role="columnheader" scope="col">Team / Home</th>
                            <th role="columnheader" scope="col">Time</th>
                            <th role="columnheader" scope="col">Location</th>
                            <th role="columnheader" scope="col">Links</th>
                        </tr>
                    </thead>
                    <tbody role="rowgroup">
                        @foreach (var item in league.Games)
                        {
                            <GameRow Item="item" Records="records" />
                        }
                    </tbody>
                </table>
                }
            </section>
        }
    </div>

    @if (listing.Total > listing.Items.Count)
    {
        <nav class="tv-week" aria-label="Schedule pages">
            @if (pageIndex > 0) { <a class="nf-btn nf-btn--secondary" href="@PageHref(pageIndex - 1)">← Earlier</a> }
            <span>Page @(pageIndex + 1) of @((listing.Total + EventsQuery.Limit - 1) / EventsQuery.Limit)</span>
            @if ((pageIndex + 1) * EventsQuery.Limit < listing.Total) { <a class="nf-btn nf-btn--secondary" href="@PageHref(pageIndex + 1)">Later →</a> }
        </nav>
    }
}

@code {
    private TeamRecords records = TeamRecords.Empty;
    [SupplyParameterFromQuery(Name = "sport")] private string? Sport { get; set; }

    [SupplyParameterFromQuery(Name = "school")] private int? School { get; set; }
    [SupplyParameterFromQuery(Name = "team")] private int? Team { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? Page { get; set; }
    [SupplyParameterFromQuery(Name = "schedule")] private string? Schedule { get; set; }
    private IReadOnlyList<ScheduleChoice> choices = [];
    private ScheduleChoice? selectedChoice;
    private int pageIndex;
    private string PageHref(int page) => "events?page=" + page + (selectedChoice is not null ? "&schedule=" + Uri.EscapeDataString(selectedChoice.Value) : "") + (selectedChoice is null && School is { } school ? "&school=" + school : "") + (selectedChoice is null && !string.IsNullOrWhiteSpace(Sport) ? "&sport=" + Uri.EscapeDataString(Sport) : "") + (selectedProvider == "espn-championship" && Team == 352 ? "&team=352" : "");
    private string? selectedProvider;

    private EventsPage? listing;
    private DateTime? lastUpdated;

    protected override async Task OnParametersSetAsync()
    {
        // "Today" is the calendar date in the display zone (Central); events are compared by their own local date.
        var today = Dates.Today;
        await using var db = await Factory.CreateDbContextAsync();
        records = await TeamRecords.LoadAsync(db, Dates.Today, RecordPhases);
        choices = await EventsQuery.GetScheduleChoicesAsync(db, today);
        selectedChoice = choices.FirstOrDefault(c => c.Value == Schedule);
        selectedProvider = await db.SportsEventsTypes.AsNoTracking().Where(s => s.Enabled && s.Id == School).Select(s => s.ProviderKey).FirstOrDefaultAsync();
        if (selectedChoice is not null) selectedProvider = selectedChoice.Provider;
        pageIndex = int.TryParse(Page, out var page) ? Math.Clamp(page, 0, 10000) : 0;
        listing = await EventsQuery.GetUpcomingAsync(db, today, selectedChoice?.Sport ?? Sport, null, school: selectedChoice is null ? School : null, providerTeamId: selectedProvider == "espn-championship" && Team == 352 ? 352 : null, offset: pageIndex * EventsQuery.Limit, provider: selectedChoice?.Provider, to: today.AddDays(3));
        pageIndex = Math.Min(pageIndex, Math.Max(0, (listing.Total - 1) / EventsQuery.Limit));
        lastUpdated = await EventsQuery.GetLastUpdatedAsync(db);
    }

    private bool IsSelected(string sport) => string.Equals(Sport?.Trim(), sport, StringComparison.OrdinalIgnoreCase);

}
