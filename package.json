{
  "name": "mynewspaper-frontend-tooling",
  "private": true,
  "description": "Lint, formatting and browser checks for myNewspaper's static JavaScript and CSS.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/browser/*.test.cjs",
    "test:browser": "node tests/browser/run.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
